+           y,
+           (int)Coord_X(coord),
+           (int)Coord_Y(coord),
+           (int)cell,
+           Cell_X(cell),
+           Cell_Y(cell),
+           object ? object->Class_Of().IniName : "(none)",
+           (int)action);
+    fflush(stdout);
+    return (int)action;
+}
