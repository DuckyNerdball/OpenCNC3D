@@ -0,0 +1,486 @@
+// OpenCNC3D Tiberian Dawn Rally: the AI drivers.
+//
+// A computer seat (and a human seat on autopilot) follows the course centre line with
+// a look-ahead that grows with speed, slows for the bends it can see coming, steps
+// aside for a racer just ahead, backs out when it is stuck and asks for a rescue when
+// that does not help. It uses its item when the item makes sense and shoots the
+// nearest racer in range, now and then a defence instead. Skill comes from the seat's
+// AI difficulty: a harder driver keeps a tighter line and goes faster.
+//
+// Bends that turn far enough are drifted for the mini-turbo, the way a player does it:
+// the driver holds its line into the bend, starts the drift into it, steers into or out
+// of the drift to stay on its line and off the walls, and lets go as the bend
+// straightens. The best drivers drift every bend that warrants it and let go on time;
+// weaker ones drift fewer, turn in early and let go late.
+//
+// It only chooses controls (the same bits a player sends); the physics are shared.
+//
+// Round a circuit the look-ahead runs on past the line into the next lap: the course's
+// segment numbers wrap round there, so every scan counts its segments forward from where
+// the driver is rather than up to a larger number.
+#include "function.h"
+#include "rally_internal.h"
+
+namespace rally {
+
+namespace {
+
+int Cps100(int64_t v)
+{
+    return (int)(v * 10 * M.TicksPerSecondX10 / 16777216);
+}
+
+int32_t Radius_Of(const Racer& r)
+{
+    return (int32_t)((int64_t)Kart_Of(r).Radius * FINE / 100);
+}
+
+int32_t Abs32(int32_t v)
+{
+    return v < 0 ? -v : v;
+}
+
+// How much the course turns, in 16-bit angle units, between two distances along it.
+int32_t Course_Turn(int64_t from, int64_t to)
+{
+    int32_t x, y;
+    int s0 = 0, s1 = 0;
+    Course_Point_At(from, &x, &y, &s0);
+    Course_Point_At(to, &x, &y, &s1);
+    int32_t most = 0;
+    const int32_t first = Course_Direction(s0);
+    const int count = Course_Segments_Between(s0, s1);
+    for (int k = 1; k <= count; ++k) {
+        const int32_t turn = Abs32(Angle_Diff(Course_Direction(s0 + k), first));
+        if (turn > most) most = turn;
+    }
+    return most;
+}
+
+bool Has_Room(const Racer& r, int32_t x, int32_t y)
+{
+    return !Point_Blocked(x, y, &r);
+}
+
+int Segment_At(int64_t along)
+{
+    int32_t x, y;
+    int s = 0;
+    Course_Point_At(along, &x, &y, &s);
+    return s;
+}
+
+// The signed turn of the course from segment a to segment b, summed segment by segment
+// so that a hairpin reads as the whole half turn instead of wrapping round.
+int32_t Course_Turn_Signed(int a, int b)
+{
+    int32_t sum = 0;
+    const int count = Course_Segments_Between(a, b);
+    for (int k = 0; k < count; ++k) sum += Angle_Diff(Course_Direction(a + k + 1), Course_Direction(a + k));
+    return sum;
+}
+
+// How far the hull still has to turn, signed, to point the way the course runs a given
+// distance ahead.
+int32_t Turn_Needed(int seg, int64_t along, int64_t ahead, int32_t yaw16)
+{
+    return Angle_Diff(Course_Direction(seg), yaw16) + Course_Turn_Signed(seg, Segment_At(along + ahead));
+}
+
+int32_t Degrees(int degrees)
+{
+    return (int32_t)((int64_t)degrees * 65536 / 360);
+}
+
+// Drift handling by AI difficulty 0..3.
+const int DRIFT_CHANCE[4] = {35, 60, 85, 100}; // percent of the bends worth a drift that get one
+const int DRIFT_TURN_IN[4] = {70, 80, 90, 100}; // turn-in point, percent of the turn a drift needs
+const int DRIFT_DEAD[4] = {12, 8, 5, 3};        // degrees off the line before steering into or out of it
+const int DRIFT_LATE[4] = {4, 2, 1, 0};         // most ticks a charged drift is held too long
+const int DRIFT_PACE = 95;                      // percent of top speed kept into a bend to be drifted
+const int DRIFT_WIDE = 50;                      // percent of the room to the side a drift's line keeps outside
+
+} // namespace
+
+void AI_Drive(Racer& r)
+{
+    if (!Racer_Alive(r) || M.Phase != RALLY_PHASE_RACE) {
+        r.Bits = 0;
+        r.AiDrift = r.AiDriftHold = r.AiDriftLate = 0;
+        return;
+    }
+    if ((r.Flags & (RALLY_F_FLIPPED | RALLY_F_RIGHTING)) || r.Z > 0 || r.Spin > 0) {
+        r.Bits = 0;
+        r.AiSlow = 0;
+        r.AiDrift = r.AiDriftHold = r.AiDriftLate = 0;
+        return;
+    }
+    const KartStats& k = Kart_Of(r);
+    const int64_t speed = r.Speed < 0 ? -(int64_t)r.Speed : r.Speed;
+    const int64_t top = Velocity(k.Top);
+    const int cps = Cps100(speed);
+
+    int64_t along = 0;
+    int32_t off_line = 0;
+    const int seg = Course_Segment_Near(r.X, r.Y, r.Segment, &along, &off_line);
+
+    // Aim at a point ahead on the centre line, farther the faster it goes.
+    const int64_t look = (int64_t)FINE * 12 / 10 + (int64_t)cps * FINE * 45 / 10000;
+    int32_t tx, ty;
+    int tseg = seg;
+    Course_Point_At(along + look, &tx, &ty, &tseg);
+
+    // A less skilled driver wanders off the ideal line.
+    if (--r.AiOffsetTimer <= 0) {
+        r.AiOffsetTimer = Ticks(15 + Random_Pick(0, 10));
+        const int spread = (3 - (r.Skill & 3)) * 10 + 10;
+        r.AiOffset = (int32_t)((int64_t)M.Point[tseg].HalfWidth * Random_Pick(-spread, spread) / 100);
+    }
+    const int32_t dir = Course_Direction(tseg);
+    const int64_t rx = Cos16(dir), ry = Sin16(dir); // right of the course
+    int64_t lateral = r.AiOffset;
+
+    // Step aside for a racer just ahead. One that is slower is in the way of a drift.
+    const int32_t yaw16 = (r.Yaw >> 8) & 0xFFFF;
+    bool crowded = false;
+    for (int i = 0; i < M.RacerCount; ++i) {
+        const Racer& o = M.Racers[i];
+        if (&o == &r || !Racer_Alive(o) || (o.Flags & RALLY_F_FINISHED)) continue;
+        const int64_t dx = (int64_t)o.X - r.X, dy = (int64_t)o.Y - r.Y;
+        const int64_t d2 = dx * dx + dy * dy;
+        if (d2 > (int64_t)FINE * FINE * 5) continue; // about 2.2 cells
+        const int32_t bearing = Angle_Diff(Angle_Of(dx, dy), yaw16);
+        if (Abs32(bearing) > 6400) continue; // about 35 degrees either side of the nose
+        if (o.Speed < r.Speed) crowded = true;
+        // Pass on the side away from it.
+        const int64_t side = (dx * rx + dy * ry) >> 16;
+        lateral += side > 0 ? -(int64_t)FINE * 9 / 10 : (int64_t)FINE * 9 / 10;
+    }
+    const int64_t hw = M.Point[tseg].HalfWidth;
+    const int64_t limit = hw - Radius_Of(r) - FINE / 4;
+    if (limit > 0) {
+        if (lateral > limit) lateral = limit;
+        if (lateral < -limit) lateral = -limit;
+    } else {
+        lateral = 0;
+    }
+    int32_t ax = (int32_t)(tx + ((rx * lateral) >> 16)), ay = (int32_t)(ty + ((ry * lateral) >> 16));
+    if (!Has_Room(r, ax, ay)) {
+        ax = tx;
+        ay = ty;
+    }
+
+    const int32_t desired = Angle_Of((int64_t)ax - r.X, (int64_t)ay - r.Y);
+    const int32_t error = Angle_Diff(desired, yaw16);
+    uint32_t bits = 0;
+    const int32_t dead = 546; // three degrees
+    if (error > dead) bits |= RALLY_IN_RIGHT;
+    if (error < -dead) bits |= RALLY_IN_LEFT;
+
+    // The least a drift turns before it has charged its mini-turbo: the physics charges it in
+    // half a second, and a drift turns at no less than 0.6 of the turn rate. A bend that
+    // turns about that much or more is worth a drift.
+    const int skill = r.Skill & 3;
+    const int32_t drift_min = (int32_t)(((int64_t)Turn_Rate(k.Turn) * SUBSTEPS * Ticks(5) * 60 / 100) >> 8);
+    if (r.AiDrift == 0) {
+        // The largest turn the course makes within about a second of driving.
+        const int64_t scan = (int64_t)FINE * 2 + (int64_t)cps * FINE / 100;
+        const int count = Course_Segments_Between(seg, Segment_At(along + scan));
+        int32_t sum = 0, most = 0, least = 0;
+        for (int k = 0; k < count; ++k) {
+            const int s = seg + k;
+            sum += Angle_Diff(Course_Direction(s + 1), Course_Direction(s));
+            if (sum > most) most = sum;
+            if (sum < least) least = sum;
+        }
+        const int way = most >= -least ? 1 : -1;
+        const int32_t bend = way > 0 ? most : -least;
+        if (bend < drift_min * 9 / 10) {
+            r.AiDriftPlan = 0;
+        } else if (r.AiDriftPlan == 0 || (r.AiDriftPlan > 0) != (way > 0)) {
+            // A new bend: whether to drift it is decided once.
+            r.AiDriftPlan = way * (Percent_Chance(DRIFT_CHANCE[skill]) ? 1 : 2);
+        }
+    }
+    const bool planned = r.AiDriftPlan == 1 || r.AiDriftPlan == -1;
+
+    // Slow down for what the course does next.
+    const int64_t brake_look = (int64_t)FINE * 2 + (int64_t)cps * FINE * 50 / 10000;
+    const int32_t corner = Course_Turn(along, along + brake_look);
+    const int corner_deg = (int)((int64_t)corner * 360 / 65536);
+    int safe = 100 - corner_deg * 55 / 90;
+    if (safe < 35) safe = 35;
+    const int error_deg = (int)((int64_t)Abs32(error) * 360 / 65536);
+    if (error_deg > 50 && safe > 40 && r.AiDrift == 0) safe = 40;
+    // A bend to be drifted is taken at pace: the drift turns the hull, not the brakes. Not
+    // with a slower racer just ahead, which would be rammed, and not before the hull points
+    // along the course and at its line: a car turning back round (spun by a blast, or
+    // facing the wrong way) keeps the slow turn-around speed above, or its wide arc ends in
+    // the outside wall.
+    const bool on_line = Abs32(Angle_Diff(Course_Direction(seg), yaw16)) < Degrees(45) && error_deg <= 50;
+    if (((planned && on_line) || r.AiDrift > 0) && !crowded && safe < DRIFT_PACE) safe = DRIFT_PACE;
+    const int64_t safe_speed = top * safe / 100;
+    if (r.Speed > safe_speed + top * 15 / 100) {
+        bits |= RALLY_IN_BRAKE;
+    } else if (r.Speed < safe_speed) {
+        bits |= RALLY_IN_THROTTLE;
+    }
+
+    const uint32_t steer_bits = RALLY_IN_LEFT | RALLY_IN_RIGHT;
+    if (r.AiDrift > 0 && r.DriftDir == 0) {
+        // The drift was lost (too slow, thrown, against a wall): this bend is driven through.
+        r.AiDrift = 0;
+        r.AiDriftLate = 0;
+        r.AiDriftPlan = r.AiDriftPlan > 0 ? 2 : r.AiDriftPlan < 0 ? -2 : 0;
+    }
+    if (r.AiDrift > 0) {
+        ++r.AiDrift;
+        const int way = r.DriftDir;
+        const uint32_t into = way > 0 ? RALLY_IN_RIGHT : RALLY_IN_LEFT;
+        const uint32_t out = way > 0 ? RALLY_IN_LEFT : RALLY_IN_RIGHT;
+        // A drift aims at the outside half of the course ahead rather than its middle: the
+        // drift turns tighter than any bend, and aimed at the middle it clips the inside.
+        const int64_t wide = limit > 0 ? -(int64_t)way * limit * DRIFT_WIDE / 100 : 0;
+        int32_t wx = (int32_t)(tx + ((rx * wide) >> 16)), wy = (int32_t)(ty + ((ry * wide) >> 16));
+        if (!Has_Room(r, wx, wy)) {
+            wx = tx;
+            wy = ty;
+        }
+        // How much more that line wants the hull to turn the drift's way.
+        const int32_t more = Angle_Diff(Angle_Of((int64_t)wx - r.X, (int64_t)wy - r.Y), yaw16) * way;
+        const int32_t dz = Degrees(DRIFT_DEAD[skill]);
+        const bool charged = (r.Flags & RALLY_F_TURBO_READY) != 0;
+        const int32_t rest = way * Turn_Needed(seg, along, (int64_t)FINE * 3 / 2 + (int64_t)cps * FINE / 400, yaw16);
+        bool let_go = false;
+        if (charged && (rest < Degrees(15) || more < -Degrees(25))) {
+            // The bend is done, or the hull already points past the line: let go, which fires
+            // the mini-turbo. A weaker driver holds on a little too long.
+            if (r.AiDriftLate == 0) r.AiDriftLate = 1 + Random_Pick(0, DRIFT_LATE[skill]);
+            if (--r.AiDriftLate <= 0) let_go = true;
+        }
+        // Turning far past the line before the charge is in, or drifting for far longer than
+        // any bend takes: give the drift up.
+        if ((!charged && more < -Degrees(35)) || r.AiDrift > Ticks(25)) let_go = true;
+        if (let_go) {
+            bits &= ~RALLY_IN_DRIFT;
+            r.AiDrift = 0;
+            r.AiDriftLate = 0;
+            r.AiDriftPlan = 2 * way;
+        } else {
+            bits = (bits & ~(steer_bits | RALLY_IN_BRAKE)) | RALLY_IN_DRIFT | RALLY_IN_THROTTLE;
+            if (more < -dz) bits |= out;
+            else if (more > dz) bits |= into;
+        }
+    } else if (planned) {
+        const int way = r.AiDriftPlan;
+        const uint32_t into = way > 0 ? RALLY_IN_RIGHT : RALLY_IN_LEFT;
+        // The turn needed within the distance the drift will cover, about three quarters
+        // of a second, and whether the hull is still roughly along the course.
+        const int32_t need = way * Turn_Needed(seg, along, (int64_t)cps * FINE * 75 / 10000, yaw16);
+        const bool aligned = Abs32(Angle_Diff(Course_Direction(seg), yaw16)) < Degrees(45);
+        const bool fast = r.Speed > top * 55 / 100 && r.Boost <= Ticks(4) && !crowded;
+        bool start = fast && aligned && error * way > 0 && need >= drift_min * DRIFT_TURN_IN[skill] / 100;
+        if (!start && fast && aligned && error * way > dead) {
+            // Hold the line into the bend, so the drift can turn in late and sharp, until a
+            // wall comes up ahead or the hold has gone on too long.
+            ++r.AiDriftHold;
+            bits &= ~into;
+            const int64_t reach = Radius_Of(r) + (int64_t)FINE * 3 / 2;
+            const int32_t hx = (int32_t)(r.X + ((Sin16(yaw16) * reach) >> 16));
+            const int32_t hy = (int32_t)(r.Y - ((Cos16(yaw16) * reach) >> 16));
+            if (!Has_Room(r, hx, hy) || r.AiDriftHold > Ticks(15)) {
+                if (need >= drift_min * 6 / 10) {
+                    start = true;
+                } else {
+                    r.AiDriftPlan = 2 * way;
+                    r.AiDriftHold = 0;
+                    bits |= into;
+                }
+            }
+        } else if (!start) {
+            r.AiDriftHold = 0;
+        }
+        if (start) {
+            // Into the bend: the physics fixes the drift's way from this steer.
+            bits = (bits & ~(steer_bits | RALLY_IN_BRAKE)) | RALLY_IN_DRIFT | RALLY_IN_THROTTLE | into;
+            r.AiDrift = 1;
+            r.AiDriftHold = 0;
+            r.AiDriftLate = 0;
+        }
+    } else {
+        r.AiDriftHold = 0;
+    }
+
+    // Stuck against something: back out with the wheels turned the other way.
+    if (speed < top * 12 / 100) {
+        ++r.AiSlow;
+        ++r.AiStuck;
+    } else {
+        r.AiSlow = 0;
+        r.AiStuck = r.AiStuck > 2 ? r.AiStuck - 2 : 0;
+    }
+    if (r.AiReverse > 0) {
+        --r.AiReverse;
+        bits = RALLY_IN_BRAKE | (error > 0 ? RALLY_IN_LEFT : RALLY_IN_RIGHT);
+        r.AiDrift = 0;
+        r.AiDriftHold = 0;
+    } else if (r.AiSlow > Ticks(10)) {
+        r.AiReverse = Ticks(8);
+        r.AiSlow = 0;
+    }
+    if (r.AiStuck > Ticks(40) && r.RescueCooldown == 0) {
+        r.RescueLatch = true;
+        r.AiStuck = 0;
+        r.AiReverse = 0;
+    }
+    // A driver going the wrong way just follows the target point back round.
+    r.Bits = bits;
+}
+
+void AI_Items(Racer& r)
+{
+    if (!Racer_Alive(r) || r.Item == RALLY_ITEM_NONE || r.Roulette > 0 || M.Phase != RALLY_PHASE_RACE) {
+        r.AiItemTicks = 0;
+        return;
+    }
+    ++r.AiItemTicks;
+    const int32_t yaw16 = (r.Yaw >> 8) & 0xFFFF;
+    const int64_t top = Velocity(Kart_Of(r).Top);
+    bool use = false;
+    switch (r.Item) {
+    case RALLY_ITEM_NITRO:
+    case RALLY_ITEM_NITRO3: {
+        // Not in a drift: a boost running when it is let go would cost the mini-turbo.
+        if (r.Boost > 0 || r.AiDrift > 0 || r.Speed < top * 30 / 100) break;
+        int64_t along = 0;
+        Course_Segment_Near(r.X, r.Y, r.Segment, &along, nullptr);
+        const int32_t turn = Course_Turn(along, along + (int64_t)FINE * 5);
+        const int32_t error = Angle_Diff(Course_Direction(r.Segment), yaw16);
+        use = turn < 3640 && Abs32(error) < 2730; // under 20 and 15 degrees
+        break;
+    }
+    case RALLY_ITEM_MINE:
+        for (int i = 0; i < M.RacerCount && !use; ++i) {
+            const Racer& o = M.Racers[i];
+            if (&o == &r || !Racer_Alive(o)) continue;
+            const int64_t dx = (int64_t)o.X - r.X, dy = (int64_t)o.Y - r.Y;
+            if (dx * dx + dy * dy > (int64_t)FINE * FINE * 9) continue;
+            if (Abs32(Angle_Diff(Angle_Of(dx, dy), yaw16)) > 16384) use = true; // behind
+        }
+        if (r.AiItemTicks > Ticks(80)) use = true;
+        break;
+    case RALLY_ITEM_ROCKET:
+        for (int i = 0; i < M.RacerCount && !use; ++i) {
+            const Racer& o = M.Racers[i];
+            if (&o == &r || !Racer_Alive(o) || o.Cloak > 0) continue;
+            const int64_t dx = (int64_t)o.X - r.X, dy = (int64_t)o.Y - r.Y;
+            if (dx * dx + dy * dy > (int64_t)FINE * FINE * 64) continue;
+            if (Abs32(Angle_Diff(Angle_Of(dx, dy), yaw16)) < 1820) use = true; // ten degrees
+        }
+        if (r.AiItemTicks > Ticks(100)) use = true;
+        break;
+    case RALLY_ITEM_REPAIR: {
+        // Held Repair blocks every other crate, so it is not saved for long: used below
+        // three quarters health, after 8 s with any damage, and after 15 s regardless.
+        const UnitClass* unit = Racer_Unit(r);
+        if (!unit) break;
+        const int strength = unit->Strength, full = unit->Class->MaxStrength;
+        use = strength * 4 < full * 3 || (strength < full && r.AiItemTicks > Ticks(80))
+              || r.AiItemTicks > Ticks(150);
+        break;
+    }
+    case RALLY_ITEM_CLOAK:
+        use = (r.LastHurt > 0 && M.RaceTicks - r.LastHurt < Ticks(10)) || r.AiItemTicks > Ticks(120);
+        break;
+    case RALLY_ITEM_HOMING:
+    case RALLY_ITEM_ION: // as soon as there is someone to send it at
+        use = Item_Target(r, r.Item) >= 0;
+        break;
+    default: // armour: at once
+        use = true;
+        break;
+    }
+    if (use) r.ItemLatch = true;
+}
+
+void AI_Fire(Racer& r)
+{
+    UnitClass* unit = Racer_Unit(r);
+    if (!unit || M.Phase != RALLY_PHASE_RACE) return;
+    const int32_t yaw16 = (r.Yaw >> 8) & 0xFFFF;
+    // No computer driver opens fire on the packed start grid: the first seconds are a race.
+    if (M.RaceTicks < Ticks(30)) {
+        Aim_Turret(r, r.X + (Sin16(yaw16) * 4), r.Y - (Cos16(yaw16) * 4));
+        return;
+    }
+    if (unit->Class->Primary == WEAPON_NONE) {
+        r.Turret = r.Yaw;
+        return;
+    }
+    const int64_t range = (int64_t)Weapons[unit->Class->Primary].Range * 256;
+    // A weapon fixed to the hull only reaches what is near straight ahead.
+    const bool fixed = !unit->Class->IsTurretEquipped;
+    const auto in_cone = [&](int64_t dx, int64_t dy) {
+        return !fixed || Abs32(Angle_Diff(Angle_Of(dx, dy), yaw16)) <= FIXED_CONE;
+    };
+
+    // Keep a target for half a second; drop it the moment it is no longer fair game.
+    TechnoClass* target = As_Techno(r.AiTarget);
+    if (target) {
+        bool keep = target->IsActive && !target->IsInLimbo && target->Strength > 0;
+        if (keep && target->What_Am_I() == RTTI_UNIT) {
+            for (int i = 0; i < M.RacerCount; ++i) {
+                const Racer& o = M.Racers[i];
+                if (o.Unit == target->As_Target() && !Racer_Fair_Game(o)) keep = false;
+            }
+        }
+        if (keep) {
+            const COORDINATE c = target->Target_Coord();
+            keep = in_cone((int64_t)Coord_X(c) * 256 - r.X, (int64_t)Coord_Y(c) * 256 - r.Y);
+        }
+        if (!keep) {
+            target = nullptr;
+            r.AiTarget = TARGET_NONE;
+        }
+    }
+    if (--r.AiTargetTimer <= 0 || !target) {
+        r.AiTargetTimer = Ticks(5);
+        target = nullptr;
+        int64_t best = range * range;
+        for (int i = 0; i < M.RacerCount; ++i) {
+            Racer& o = M.Racers[i];
+            if (&o == &r || !Racer_Fair_Game(o)) continue;
+            const int64_t dx = (int64_t)o.X - r.X, dy = (int64_t)o.Y - r.Y;
+            const int64_t d2 = dx * dx + dy * dy;
+            if (d2 < best && in_cone(dx, dy)) {
+                best = d2;
+                target = Racer_Unit(o);
+            }
+        }
+        if (!target && Percent_Chance(30)) {
+            int64_t closest = range * range;
+            for (int i = 0; i < Buildings.Count(); ++i) {
+                BuildingClass* b = Buildings.Ptr(i);
+                if (!b || !b->IsActive || b->IsInLimbo || b->Strength <= 0 || b->Owner() != M.Hostile) continue;
+                const COORDINATE c = b->Center_Coord();
+                const int64_t dx = (int64_t)Coord_X(c) * 256 - r.X, dy = (int64_t)Coord_Y(c) * 256 - r.Y;
+                const int64_t d2 = dx * dx + dy * dy;
+                if (d2 < closest && in_cone(dx, dy)) {
+                    closest = d2;
+                    target = b;
+                }
+            }
+        }
+        r.AiTarget = target ? target->As_Target() : TARGET_NONE;
+    }
+    if (!target) {
+        Aim_Turret(r, r.X + (Sin16(yaw16) * 4), r.Y - (Cos16(yaw16) * 4));
+        return;
+    }
+    const COORDINATE c = target->Target_Coord();
+    const int32_t tx = Coord_X(c) * 256, ty = Coord_Y(c) * 256;
+    Aim_Turret(r, tx, ty);
+    Fire_Weapon(r, target->As_Target(), tx, ty, false);
+}
+
+} // namespace rally
diff --git a/tiberiandawn/rally_internal.h b/tiberiandawn/rally_internal.h
new file mode 100644
index 0000000..4041a05
--- /dev/null
+++ b/tiberiandawn/rally_internal.h
@@ -0,0 +1,312 @@
+// OpenCNC3D Tiberian Dawn Rally: state shared by the Rally source files.
+//
+// rally.cpp owns the match (phases, seats, course, crates, progress, the exports),
+// rally_physics.cpp moves the vehicles, rally_items.cpp runs the items and the
+// hazards they leave on the course, and rally_ai.cpp drives the computer seats.
+// Nothing outside those four files includes this header; the engine sees rally.h.
+//
+// Everything here is simulation state and is computed in integers only, so every
+// peer of a lockstep match arrives at the same race from the same orders.
+#ifndef TD_RALLY_INTERNAL_H
+#define TD_RALLY_INTERNAL_H
+
+#include <stdint.h>
+#include "rally.h"
+#include "../../../game/rally_abi.h"
+
+namespace rally {
+
+enum
+{
+    SUBSTEPS = 4,         // physics steps per engine tick
+    FINE = 65536,         // fine units per cell
+    MAX_GRID = 8,
+    MAX_ROSTER = 16,
+    STAT_COUNT = RALLY_STAT_COUNT,
+    FIXED_CONE = 5461,    // a weapon without a turret fires within 30 degrees of the nose
+    DEFENCE_HIT_MAX = 85, // percent of full health one hit from a course defence may take
+    RACE_LIMIT = 1800,    // tenths of a second per lap: a race ends after three minutes a lap regardless
+    MAX_FIXTURES = 512,   // course objects remembered at the start, for the reset of a retry
+};
+
+// Counters for tests and the report (RALLY_DEBUG_STAT); nothing in the race reads them.
+enum
+{
+    STAT_CRATES = RALLY_STAT_CRATES,
+    STAT_ITEMS = RALLY_STAT_ITEMS,
+    STAT_HAZARDS = RALLY_STAT_HAZARDS,
+    STAT_BLASTS = RALLY_STAT_BLASTS,
+    STAT_RESPAWNS = RALLY_STAT_RESPAWNS,
+    STAT_FLIPS = RALLY_STAT_FLIPS,
+    STAT_RIGHTED = RALLY_STAT_RIGHTED,
+    STAT_SHOTS = RALLY_STAT_SHOTS,
+    STAT_RUN_OVER = RALLY_STAT_RUN_OVER,
+    STAT_WALL_HITS = RALLY_STAT_WALL_HITS,
+    STAT_RAMS = RALLY_STAT_RAMS,
+    STAT_RESCUES = RALLY_STAT_RESCUES,
+    STAT_THROWN = RALLY_STAT_THROWN,
+    STAT_DEFENCE_HITS = RALLY_STAT_DEFENCE_HITS,
+    STAT_RACER_HITS = RALLY_STAT_RACER_HITS,
+    STAT_DEFENCE_DAMAGE = RALLY_STAT_DEFENCE_DAMAGE,
+    STAT_DEFENCE_KILLS = RALLY_STAT_DEFENCE_KILLS,
+    STAT_MINI_TURBOS = RALLY_STAT_MINI_TURBOS,
+};
+
+// Per vehicle handling. Speeds are cells per second x100, angles degrees per second,
+// grip and mass x100, the radius in cells x100.
+struct KartStats
+{
+    int Type;
+    int Top;
+    int Accel;
+    int Turn;
+    int Grip;
+    int Mass;
+    int Radius;
+};
+
+struct Racer
+{
+    // Seat.
+    HousesType House;
+    int Seat;
+    bool Human;
+    bool Autopilot;
+    int Skill;   // AI difficulty 0..3
+    int Kart;    // index into the kart table, -1 until picked (a retry keeps the last one)
+    bool Picked; // chosen in this PICK (computer seats choose at once)
+    int LastKart; // the vehicle of the previous race of the match, -1 in the first
+    int GridSlot; // the grid slot it started this race from, -1 before the grid is drawn
+    TARGET Unit; // the engine unit, TARGET_NONE while dead or not yet spawned
+
+    // Motion. Positions in fine units (1/256 lepton); velocities in fine units per
+    // engine tick with 8 extra fraction bits; angles are 16-bit binary angles with
+    // 8 extra fraction bits (a full turn is 1 << 24).
+    int32_t X, Y, Z;
+    int32_t VX, VY, VZ;
+    int32_t Yaw, Turret;
+    int32_t Pitch, Roll;
+    int32_t PitchRate, RollRate, SpinRate;
+    int32_t Speed;    // forward speed of the last step, same units as VX
+    int32_t Impact;   // hardest wall impact this tick, same units
+    int32_t PrevX, PrevY;
+
+    // Controls (the last RALLY_INPUT of a human seat, or the AI's choice).
+    uint32_t Bits;
+    int32_t AimX, AimY;
+    bool ItemLatch, RescueLatch;
+    bool DriftWasOn;
+
+    // Race.
+    int Checkpoint; // last course point passed; on a circuit, in the lap being driven
+    int Segment;    // course segment the projection lies on
+    int Progress;   // 0..65536 over the whole race
+    int LapProgress; // 0..65536 over the lap being driven
+    int LapsDone;   // laps completed (crossings of the line that counted)
+    int64_t Dist;   // fine units along the course from the start line, counted on over
+                    // every lap and negative behind the line; on a point-to-point course the
+                    // projection itself (negative behind the start line as well)
+    int Place;
+    int FinishTicks;
+    int Flags;
+    int Item, ItemCount;
+    int Kills;
+    int DriftCharge;
+    int DriftDir;     // -1 left, 1 right: the way a drift turns, fixed when it starts
+    int Boost, BoostTop, BoostAccel;
+    int Armour, Cloak, Spin, Shield;
+    int Roulette;
+    int Dead;
+    int FlipTicks, Righting;
+    int32_t RightingRoll, RightingPitch;
+    int WrongWay;
+    int RescueCooldown;
+    int Reload;
+    int LastHurt; // race tick of the last damage, for the cloak decision
+
+    // AI driver.
+    int32_t AiOffset;
+    int AiOffsetTimer;
+    int AiReverse;
+    int AiStuck;
+    int AiSlow;
+    int AiItemTicks; // how long the AI has held its item
+    TARGET AiTarget; // what the AI shoots at
+    int AiTargetTimer;
+    int AiDrift;     // ticks the AI has held its current drift, 0 when it is not drifting
+    int AiDriftPlan; // the bend ahead: 0 none, +-1 to be drifted, +-2 driven through (sign: the way it turns)
+    int AiDriftHold; // ticks spent holding the line into a bend before the drift starts
+    int AiDriftLate; // ticks a charged drift is still held before letting go, 0 until that is due
+};
+
+struct CoursePoint
+{
+    int32_t X, Y, HalfWidth; // fine units
+    int64_t Along;           // fine units of course length from point 0
+};
+
+struct Crate
+{
+    int32_t X, Y;
+    CELL Cell;
+    bool Active;
+    int Return; // ticks until it comes back
+};
+
+struct Hazard
+{
+    int Kind;
+    int32_t X, Y, Z;
+    int32_t Yaw;   // 16-bit << 8
+    int Owner;     // racer index
+    int Ticks;     // age, or ticks left for an ion mark
+    int Target;    // racer index for homing and ion, -1 none
+    int Bounces;
+    int Segment;   // course segment a homing missile is following
+};
+
+// An object of the course as it stood when the match started (a defence, a building, a
+// unit or a soldier of a house that is not a seat, or a tree), so that a retry can put the
+// course back the way it was.
+enum
+{
+    FIXTURE_BUILDING,
+    FIXTURE_UNIT,
+    FIXTURE_INFANTRY,
+    FIXTURE_TERRAIN,
+};
+
+struct Fixture
+{
+    int Kind;          // FIXTURE_*
+    int Type;          // StructType, UnitType, InfantryType or TerrainType
+    HousesType House;
+    COORDINATE Coord;  // where it stood (a tree: the top left of its cell)
+    int Facing;        // DirType it faced
+    int Strength;
+    TARGET Live;       // the object standing for it now, TARGET_NONE once it is gone
+};
+
+struct Match
+{
+    bool Enabled;
+    bool Loaded;   // a [Rally] section was read for this scenario
+    bool Started;  // the first Rally tick has set the match up
+    bool Over;     // the result has been handed to the engine
+    int TicksPerSecondX10;
+    int ConfigLaps; // laps asked for before the match (OpenCNC3D_Rally_Configure)
+
+    char Name[64];
+    HousesType Hostile;
+    bool Loop;     // a circuit: the last point joins the first and the line is crossed every lap
+    int Laps;      // laps in a race (1 on a point-to-point course)
+    int PointCount;
+    CoursePoint Point[RALLY_MAX_COURSE];
+    int64_t Length; // one lap (on a circuit, the closing segment included)
+    int GridFacing;
+    int GridCount;
+    int32_t GridX[MAX_GRID], GridY[MAX_GRID];
+    int32_t FinishX1, FinishY1, FinishX2, FinishY2;
+    int CrateCount;
+    Crate Crates[RALLY_MAX_CRATES];
+
+    int Phase;
+    int PhaseTicks;
+    int RaceTicks;
+    int AfterWinner;
+    int RacerCount;
+    Racer Racers[RALLY_MAX_RACERS];
+    int FinishedCount;
+    int FinishOrder[RALLY_MAX_RACERS];
+    int Winner;
+    int HazardCount;
+    Hazard Hazards[RALLY_MAX_HAZARDS];
+
+    int RaceNumber; // 1 for the first race of the match, one more for every retry
+    int Decider;    // racer index of the player whose choice ends the results, -1 none
+    int Choice;     // RALLY_CHOICE_* of the deciding player, NONE while waiting
+    int AutoEnd;    // ticks of results left before the match ends by itself with no decider
+
+    int FixtureCount;
+    Fixture Fixtures[MAX_FIXTURES];
+
+    int Stats[STAT_COUNT];
+    bool RallyDamage;     // Rally itself is applying this damage: no automatic throw
+    bool InTick;          // inside Rally_Tick, where racers fire before they move
+    bool DebugIgnoreShield;
+    unsigned DebugSeed;
+    bool DebugSeedSet;
+};
+
+extern Match M;
+extern const KartStats Karts[MAX_ROSTER];
+extern const int KartCount;
+
+// Units and conversions (rally.cpp).
+int32_t Velocity(int cells_per_second_x100);   // -> fine per tick << 8
+int32_t Accel(int cells_per_second2_x100);     // -> (fine per tick << 8) per substep
+int32_t Turn_Rate(int degrees_per_second);     // -> angle << 8 per substep
+int32_t Decay(int per_second_x100);            // -> fraction of 65536 removed per substep
+int Ticks(int tenths_of_second);
+int32_t Sin16(int32_t angle);                  // 16-bit angle -> 16.16
+int32_t Cos16(int32_t angle);
+int32_t Angle_Of(int64_t dx, int64_t dy);      // vector -> 16-bit angle (0 north, clockwise)
+int64_t Isqrt(uint64_t value);
+int32_t Angle_Diff(int32_t to, int32_t from);  // signed 16-bit difference
+
+// Racers and the engine (rally.cpp).
+UnitClass* Racer_Unit(const Racer& r);
+const KartStats& Kart_Of(const Racer& r);
+bool Racer_Alive(const Racer& r);
+bool Racer_Out(const Racer& r);        // the seat has left the match
+bool Racer_Fair_Game(const Racer& r);  // alive and neither cloaked, shielded, finished nor out
+int Racer_Near(const Racer& r, int32_t x, int32_t y, int32_t reach);
+bool Racer_Index_Valid(int index);
+int Racer_By_Place(int place);
+void Damage_Racer(Racer& r, int damage, int source_racer);
+void Throw_Racer(Racer& r, int damage, int scale_percent);
+bool Teleport_To_Checkpoint(Racer& r);
+void Racer_Timers(Racer& r);
+
+// The course (rally.cpp). Segment s runs from point s to point s + 1; on a circuit the
+// last segment runs from the last point back to point 0, and segment numbers wrap round.
+int32_t Course_Direction(int segment);
+int Course_Segment_Near(int32_t x, int32_t y, int hint, int64_t* along, int32_t* distance);
+void Course_Point_At(int64_t along, int32_t* x, int32_t* y, int* segment); // along wraps on a circuit
+int Course_Wrap_Segment(int segment);
+int Course_Segments_Between(int from, int to); // segments forward from one to the other
+int64_t Course_Delta(int64_t to, int64_t from); // signed distance along; the short way round a circuit
+
+// Physics (rally_physics.cpp). One engine tick of one racer's driving is Drive_Begin, then
+// SUBSTEPS of Drive_Substep, then Drive_End; the race interleaves the racers' substeps with
+// their collisions, and OpenCNC3D_Rally_Predict runs the same three on a copy. stats is
+// M.Stats in the race and a scratch array in a prediction, which changes nothing else.
+bool Cell_Blocked(CELL cell, const Racer* r);
+bool Point_Blocked(int32_t x, int32_t y, const Racer* r);
+void Drive_Begin(Racer& r);
+void Drive_Substep(Racer& r, int* stats);
+void Drive_End(Racer& r, int* stats);
+void Physics_Tick();
+void Sync_Engine(Racer& r);
+void Run_Over(Racer& r);
+
+// Weapons (rally.cpp).
+void Aim_Turret(Racer& r, int32_t tx, int32_t ty);
+void Fire_Weapon(Racer& r, TARGET target, int32_t tx, int32_t ty, bool clamp);
+
+// Items (rally_items.cpp).
+void Items_Tick();
+void Use_Item(Racer& r);
+void Nitro_Burst(Racer& r);
+int Item_Target(const Racer& r, int item);  // whom a homing missile or the ion cannon would go for
+bool Collect_Crate(Racer& r, CELL cell);
+void Place_Crate(Crate& c);
+
+// AI (rally_ai.cpp).
+void AI_Drive(Racer& r);
+void AI_Fire(Racer& r);
+void AI_Items(Racer& r);
+
+} // namespace rally
+
+#endif
diff --git a/tiberiandawn/rally_items.cpp b/tiberiandawn/rally_items.cpp
new file mode 100644
index 0000000..7d074fa
--- /dev/null
+++ b/tiberiandawn/rally_items.cpp
@@ -0,0 +1,456 @@
+// OpenCNC3D Tiberian Dawn Rally: crates, items and the hazards they leave.
+//
+// A racer that drives into a course crate gets a one second roulette and then an item,
+// weighted by its place the way kart racers do it: the leader gets defensive items,
+// the back of the pack the strong ones. One item is held at a time. Mines, rockets,
+// homing missiles and the ion cannon's warning mark are simulated here as hazards;
+// their explosions are ordinary engine animations at the spot, so they are drawn and
+// heard like any other, and their damage goes through the engine's Take_Damage.
+#include "function.h"
+#include "rally_internal.h"
+
+namespace rally {
+
+namespace {
+
+struct Weight
+{
+    int Item;
+    int Chance;
+};
+
+const Weight Leader[] = {
+    {RALLY_ITEM_NITRO, 35}, {RALLY_ITEM_MINE, 30}, {RALLY_ITEM_ROCKET, 25}, {RALLY_ITEM_REPAIR, 10}};
+const Weight Middle[] = {{RALLY_ITEM_NITRO, 15},  {RALLY_ITEM_NITRO3, 10}, {RALLY_ITEM_MINE, 15},
+                         {RALLY_ITEM_ROCKET, 15}, {RALLY_ITEM_HOMING, 15}, {RALLY_ITEM_ION, 3},
+                         {RALLY_ITEM_ARMOUR, 10}, {RALLY_ITEM_CLOAK, 10},  {RALLY_ITEM_REPAIR, 7}};
+const Weight Back[] = {{RALLY_ITEM_NITRO3, 25}, {RALLY_ITEM_HOMING, 25}, {RALLY_ITEM_ION, 10},
+                       {RALLY_ITEM_ARMOUR, 20}, {RALLY_ITEM_CLOAK, 20}};
+
+template <int N> int Draw(const Weight (&table)[N])
+{
+    int total = 0;
+    for (int i = 0; i < N; ++i) total += table[i].Chance;
+    int roll = Random_Pick(0, total - 1);
+    for (int i = 0; i < N; ++i) {
+        if (roll < table[i].Chance) return table[i].Item;
+        roll -= table[i].Chance;
+    }
+    return table[0].Item;
+}
+
+int Pick_Item(const Racer& r)
+{
+    const int n = M.RacerCount;
+    if (r.Place <= 1) return Draw(Leader);
+    if (r.Place == n || r.Place > n - n / 3) return Draw(Back);
+    return Draw(Middle);
+}
+
+int32_t Radius_Of(const Racer& r)
+{
+    return (int32_t)((int64_t)Kart_Of(r).Radius * FINE / 100);
+}
+
+int64_t Distance2(int32_t ax, int32_t ay, int32_t bx, int32_t by)
+{
+    const int64_t dx = (int64_t)ax - bx, dy = (int64_t)ay - by;
+    return dx * dx + dy * dy;
+}
+
+COORDINATE Coord_Of(int32_t x, int32_t y)
+{
+    return XY_Coord(x >> 8, y >> 8);
+}
+
+// Rockets fly over water and units; walls, buildings, trees and the map edge stop them.
+bool Hazard_Blocked(int32_t x, int32_t y)
+{
+    if (x < 0 || y < 0) return true;
+    const int cx = x >> 16, cy = y >> 16;
+    if (cx < Map.MapCellX || cy < Map.MapCellY || cx >= Map.MapCellX + Map.MapCellWidth
+        || cy >= Map.MapCellY + Map.MapCellHeight) {
+        return true;
+    }
+    const CellClass& c = Map[XY_Cell(cx, cy)];
+    if (c.Overlay != OVERLAY_NONE && OverlayTypeClass::As_Reference(c.Overlay).IsWall) return true;
+    if (c.Land_Type() == LAND_ROCK || c.Land_Type() == LAND_WALL) return true;
+    return c.Cell_Building() != nullptr || c.Cell_Terrain() != nullptr;
+}
+
+Hazard* Add_Hazard(int kind, int owner, int32_t x, int32_t y, int32_t yaw)
+{
+    if (M.HazardCount >= RALLY_MAX_HAZARDS) {
+        // Full: the oldest mine makes room; anything else is simply not made.
+        int oldest = -1;
+        for (int i = 0; i < M.HazardCount; ++i) {
+            if (M.Hazards[i].Kind == RALLY_HAZ_MINE) {
+                oldest = i;
+                break;
+            }
+        }
+        if (oldest < 0) return nullptr;
+        for (int i = oldest; i + 1 < M.HazardCount; ++i) M.Hazards[i] = M.Hazards[i + 1];
+        --M.HazardCount;
+    }
+    Hazard& h = M.Hazards[M.HazardCount++];
+    memset(&h, 0, sizeof h);
+    h.Kind = kind;
+    h.Owner = owner;
+    h.X = x;
+    h.Y = y;
+    h.Yaw = yaw & 0xFFFFFF;
+    h.Target = -1;
+    ++M.Stats[STAT_HAZARDS];
+    return &h;
+}
+
+// Damage and a throw for every racer within reach of a blast; the direct victim, if
+// any, takes the full damage and the rest half.
+void Blast(int32_t x, int32_t y, AnimType anim, int owner, int victim, int damage, int reach, int throw_scale)
+{
+    new AnimClass(anim, Coord_Of(x, y));
+    ++M.Stats[STAT_BLASTS];
+    for (int i = 0; i < M.RacerCount; ++i) {
+        Racer& r = M.Racers[i];
+        if (!Racer_Alive(r) || (r.Flags & RALLY_F_FINISHED)) continue;
+        const int64_t limit = (int64_t)reach + Radius_Of(r);
+        const bool direct = i == victim;
+        if (!direct && Distance2(x, y, r.X, r.Y) > limit * limit) continue;
+        const int dealt = direct ? damage : damage / 2;
+        const bool immune = r.Shield > 0 || r.Armour > 0;
+        Damage_Racer(r, dealt, owner);
+        if (!immune && Racer_Alive(r)) {
+            Throw_Racer(r, dealt, throw_scale);
+            r.Spin = Ticks(8);
+            r.SpinRate = Turn_Rate(Random_Pick(0, 1) ? 720 : -720);
+        }
+    }
+}
+
+// The hostile building a rocket ran into, if any, takes the rocket's damage.
+void Hit_Building(int32_t x, int32_t y, int owner, int damage)
+{
+    if (x < 0 || y < 0 || (x >> 16) >= MAP_CELL_W || (y >> 16) >= MAP_CELL_H) return;
+    BuildingClass* building = Map[XY_Cell(x >> 16, y >> 16)].Cell_Building();
+    if (!building || !building->IsActive || building->Strength <= 0) return;
+    TechnoClass* source = Racer_Index_Valid(owner) ? (TechnoClass*)Racer_Unit(M.Racers[owner]) : nullptr;
+    int dealt = damage;
+    building->Take_Damage(dealt, 0, WARHEAD_HE, source);
+}
+
+// Nothing that stops a rocket on the straight line between two points, sampled every
+// quarter cell.
+bool Hazard_Line_Clear(int32_t x0, int32_t y0, int32_t x1, int32_t y1)
+{
+    const int64_t dx = (int64_t)x1 - x0, dy = (int64_t)y1 - y0;
+    const int64_t len = Isqrt((uint64_t)(dx * dx + dy * dy));
+    const int steps = (int)(len / (FINE / 4)) + 1;
+    for (int i = 1; i < steps; ++i) {
+        if (Hazard_Blocked((int32_t)(x0 + dx * i / steps), (int32_t)(y0 + dy * i / steps))) return false;
+    }
+    return true;
+}
+
+// A racer a homing missile or the ion cannon may pick: on the course, not finished,
+// still in the match; a homing missile also cannot see a cloaked one.
+bool Item_Can_Target(const Racer& t, bool see_cloak)
+{
+    return Racer_Alive(t) && !(t.Flags & (RALLY_F_FINISHED | RALLY_F_RETIRED)) && (see_cloak || t.Cloak == 0);
+}
+
+int Racer_Hit(const Hazard& h, int32_t x, int32_t y, int self_grace)
+{
+    for (int i = 0; i < M.RacerCount; ++i) {
+        const Racer& r = M.Racers[i];
+        if (!Racer_Alive(r) || (r.Flags & RALLY_F_FINISHED) || r.Z > FINE / 2) continue;
+        if (i == h.Owner && h.Ticks < self_grace) continue;
+        const int64_t reach = Radius_Of(r) + FINE / 5;
+        if (Distance2(x, y, r.X, r.Y) < reach * reach) return i;
+    }
+    return -1;
+}
+
+bool Update_Mine(Hazard& h)
+{
+    ++h.Ticks;
+    if (h.Ticks < Ticks(5)) return false; // arming
+    for (int i = 0; i < M.RacerCount; ++i) {
+        const Racer& r = M.Racers[i];
+        if (!Racer_Alive(r) || (r.Flags & RALLY_F_FINISHED) || r.Z > FINE / 4) continue;
+        if (i == h.Owner && h.Ticks < Ticks(10)) continue;
+        const int64_t reach = (int64_t)FINE * 45 / 100 + Radius_Of(r) / 2;
+        if (Distance2(h.X, h.Y, r.X, r.Y) < reach * reach) {
+            Blast(h.X, h.Y, ANIM_ART_EXP1, h.Owner, i, 60, FINE * 3 / 4, 100);
+            return true;
+        }
+    }
+    return h.Ticks > Ticks(900);
+}
+
+bool Update_Missile(Hazard& h)
+{
+    const bool homing = h.Kind == RALLY_HAZ_HOMING;
+    if (homing && Racer_Index_Valid(h.Target) && !Item_Can_Target(M.Racers[h.Target], false)) h.Target = -1;
+    const int32_t step = Velocity(homing ? 1200 : 1400) / (256 * SUBSTEPS);
+    const int32_t turn = Turn_Rate(homing ? 450 : 300);
+    for (int s = 0; s < SUBSTEPS; ++s) {
+        if (homing && Racer_Index_Valid(h.Target)) {
+            const Racer& t = M.Racers[h.Target];
+            // Far from its target, or with something in the way, a homing missile flies
+            // along the course toward it, the way the racers drive, rather than straight
+            // into the course's walls; close and in sight, it homes.
+            int32_t gx = t.X, gy = t.Y;
+            const int64_t close_range = (int64_t)FINE * 4;
+            if (Distance2(h.X, h.Y, t.X, t.Y) > close_range * close_range || !Hazard_Line_Clear(h.X, h.Y, t.X, t.Y)) {
+                int64_t along = 0, target_along = 0;
+                h.Segment = Course_Segment_Near(h.X, h.Y, h.Segment, &along, nullptr);
+                Course_Segment_Near(t.X, t.Y, t.Segment, &target_along, nullptr);
+                const int64_t look = (int64_t)FINE * 3 / 2;
+                // The short way round a circuit.
+                Course_Point_At(Course_Delta(target_along, along) >= 0 ? along + look : along - look, &gx, &gy,
+                                nullptr);
+            }
+            const int32_t want = Angle_Of((int64_t)gx - h.X, (int64_t)gy - h.Y);
+            int32_t diff = Angle_Diff(want, (h.Yaw >> 8) & 0xFFFF) * 256;
+            if (diff > turn) diff = turn;
+            if (diff < -turn) diff = -turn;
+            h.Yaw = (h.Yaw + diff) & 0xFFFFFF;
+        }
+        const int32_t yaw16 = (h.Yaw >> 8) & 0xFFFF;
+        const int32_t nx = h.X + (int32_t)(((int64_t)Sin16(yaw16) * step) >> 16);
+        const int32_t ny = h.Y - (int32_t)(((int64_t)Cos16(yaw16) * step) >> 16);
+        if (Hazard_Blocked(nx, ny)) {
+            if (h.Bounces > 0) {
+                // Bounce off the face it ran into.
+                const bool bx = Hazard_Blocked(nx, h.Y);
+                const bool by = Hazard_Blocked(h.X, ny);
+                if (bx && !by) h.Yaw = (-(h.Yaw)) & 0xFFFFFF;
+                else if (by && !bx) h.Yaw = ((32768 << 8) - h.Yaw) & 0xFFFFFF;
+                else h.Yaw = (h.Yaw + (32768 << 8)) & 0xFFFFFF;
+                --h.Bounces;
+                continue;
+            }
+            Hit_Building(nx, ny, h.Owner, homing ? 90 : 80);
+            Blast(h.X, h.Y, ANIM_FBALL1, h.Owner, -1, homing ? 90 : 80, FINE / 2, 100);
+            return true;
+        }
+        h.X = nx;
+        h.Y = ny;
+        const int victim = Racer_Hit(h, h.X, h.Y, Ticks(3));
+        if (victim >= 0) {
+            Blast(h.X, h.Y, ANIM_FBALL1, h.Owner, victim, homing ? 90 : 80, FINE / 2, 100);
+            return true;
+        }
+    }
+    ++h.Ticks;
+    if (h.Ticks > Ticks(80)) {
+        Blast(h.X, h.Y, ANIM_FBALL1, h.Owner, -1, homing ? 90 : 80, FINE / 2, 100);
+        return true;
+    }
+    return false;
+}
+
+bool Update_Ion(Hazard& h)
+{
+    if (Racer_Index_Valid(h.Target)) {
+        const Racer& t = M.Racers[h.Target];
+        if (Racer_Alive(t) && !(t.Flags & RALLY_F_FINISHED)) {
+            h.X = t.X;
+            h.Y = t.Y;
+        } else {
+            h.Target = -1; // stays where its target fell
+        }
+    }
+    if (--h.Ticks > 0) return false;
+    // The beam: the engine's own ion animation, whose engine damage Rally turns off.
+    new AnimClass(ANIM_ION_CANNON, Coord_Of(h.X, h.Y));
+    ++M.Stats[STAT_BLASTS];
+    const int64_t reach = (int64_t)FINE * 5 / 4;
+    for (int i = 0; i < M.RacerCount; ++i) {
+        Racer& r = M.Racers[i];
+        if (!Racer_Alive(r) || (r.Flags & RALLY_F_FINISHED)) continue;
+        if (Distance2(h.X, h.Y, r.X, r.Y) > reach * reach) continue;
+        const bool immune = r.Shield > 0 || r.Armour > 0;
+        Damage_Racer(r, 150, h.Owner);
+        if (!immune && Racer_Alive(r)) Throw_Racer(r, 150, 140);
+    }
+    return true;
+}
+
+} // namespace
+
+// Whom a homing missile (the racer one place ahead, or the nearest one behind for the
+// leader) or the ion cannon (the best placed racer) of racer r would go for, or -1.
+// Racers that have finished or left are skipped: an item spent on them is wasted.
+int Item_Target(const Racer& r, int item)
+{
+    const int self = (int)(&r - M.Racers);
+    if (item == RALLY_ITEM_ION) {
+        for (int place = 1; place <= M.RacerCount; ++place) {
+            const int i = Racer_By_Place(place);
+            if (i >= 0 && i != self && Item_Can_Target(M.Racers[i], true)) return i;
+        }
+        return -1;
+    }
+    for (int place = r.Place - 1; place >= 1; --place) {
+        const int i = Racer_By_Place(place);
+        if (i >= 0 && i != self && Item_Can_Target(M.Racers[i], false)) return i;
+    }
+    for (int place = r.Place + 1; place <= M.RacerCount; ++place) {
+        const int i = Racer_By_Place(place);
+        if (i >= 0 && i != self && Item_Can_Target(M.Racers[i], false)) return i;
+    }
+    return -1;
+}
+
+bool Collect_Crate(Racer& r, CELL cell)
+{
+    Crate* crate = nullptr;
+    for (int i = 0; i < M.CrateCount; ++i) {
+        if (M.Crates[i].Active && M.Crates[i].Cell == cell) {
+            crate = &M.Crates[i];
+            break;
+        }
+    }
+    if (!crate) return false;
+    if (!Racer_Alive(r) || r.Item != RALLY_ITEM_NONE || r.Roulette > 0 || (r.Flags & RALLY_F_FINISHED)) return false;
+    crate->Active = false;
+    crate->Return = Ticks(50);
+    CellClass& c = Map[cell];
+    c.Redraw_Objects();
+    c.Overlay = OVERLAY_NONE;
+    c.OverlayData = 0;
+    r.Roulette = Ticks(10);
+    r.Flags |= RALLY_F_ROULETTE;
+    ++M.Stats[STAT_CRATES];
+    return true;
+}
+
+// A nitro's speed burst. The prediction of the local racer fires it the same way.
+void Nitro_Burst(Racer& r)
+{
+    r.Boost = Ticks(12);
+    r.BoostTop = 160;
+    r.BoostAccel = 250;
+}
+
+void Use_Item(Racer& r)
+{
+    UnitClass* unit = Racer_Unit(r);
+    if (!unit || (r.Flags & RALLY_F_FINISHED)) return;
+    const int self = (int)(&r - M.Racers);
+    const int32_t yaw16 = (r.Yaw >> 8) & 0xFFFF;
+    const int64_t fx = Sin16(yaw16), fy = -Cos16(yaw16);
+    const int32_t radius = Radius_Of(r);
+    switch (r.Item) {
+    case RALLY_ITEM_NITRO:
+    case RALLY_ITEM_NITRO3:
+        Nitro_Burst(r);
+        break;
+    case RALLY_ITEM_MINE: {
+        const int64_t back = radius + FINE * 45 / 100;
+        int32_t x = (int32_t)(r.X - ((fx * back) >> 16)), y = (int32_t)(r.Y - ((fy * back) >> 16));
+        if (Hazard_Blocked(x, y)) {
+            x = r.X;
+            y = r.Y;
+        }
+        Add_Hazard(RALLY_HAZ_MINE, self, x, y, r.Yaw);
+        break;
+    }
+    case RALLY_ITEM_ROCKET:
+    case RALLY_ITEM_HOMING: {
+        const int64_t ahead = radius + FINE * 3 / 10;
+        int32_t x = (int32_t)(r.X + ((fx * ahead) >> 16)), y = (int32_t)(r.Y + ((fy * ahead) >> 16));
+        if (Hazard_Blocked(x, y)) {
+            x = r.X;
+            y = r.Y;
+        }
+        const bool homing = r.Item == RALLY_ITEM_HOMING;
+        const int target = homing ? Item_Target(r, RALLY_ITEM_HOMING) : -1;
+        if (homing && target < 0) return; // nobody to seek: keep the item
+        Hazard* h = Add_Hazard(homing ? RALLY_HAZ_HOMING : RALLY_HAZ_ROCKET, self, x, y, r.Yaw);
+        if (h) {
+            h->Z = FINE / 4;
+            h->Bounces = homing ? 1 : 2;
+            h->Target = target;
+            h->Segment = r.Segment;
+        }
+        break;
+    }
+    case RALLY_ITEM_ION: {
+        const int target = Item_Target(r, RALLY_ITEM_ION);
+        if (target < 0) return; // nobody to strike: keep the item
+        const Racer& t = M.Racers[target];
+        Hazard* h = Add_Hazard(RALLY_HAZ_ION_MARK, self, t.X, t.Y, 0);
+        if (!h) return;
+        h->Target = target;
+        h->Ticks = Ticks(15);
+        break;
+    }
+    case RALLY_ITEM_ARMOUR:
+        r.Armour = Ticks(60);
+        break;
+    case RALLY_ITEM_CLOAK:
+        r.Cloak = Ticks(60);
+        break;
+    case RALLY_ITEM_REPAIR:
+        unit->Strength = unit->Class->MaxStrength;
+        unit->Mark(MARK_CHANGE);
+        break;
+    default:
+        return;
+    }
+    ++M.Stats[STAT_ITEMS];
+    if (--r.ItemCount <= 0) {
+        r.Item = RALLY_ITEM_NONE;
+        r.ItemCount = 0;
+    }
+}
+
+void Items_Tick()
+{
+    for (int i = 0; i < M.RacerCount; ++i) {
+        Racer& r = M.Racers[i];
+        if (r.Roulette > 0 && --r.Roulette == 0) {
+            r.Item = Pick_Item(r);
+            r.ItemCount = r.Item == RALLY_ITEM_NITRO3 ? 3 : 1;
+        }
+    }
+    for (int i = 0; i < M.CrateCount; ++i) {
+        Crate& c = M.Crates[i];
+        if (c.Active || c.Return <= 0) continue;
+        if (--c.Return > 0) continue;
+        // Not back under a vehicle that is standing on the spot.
+        bool covered = false;
+        for (int j = 0; j < M.RacerCount; ++j) {
+            const Racer& r = M.Racers[j];
+            if (Racer_Alive(r) && XY_Cell(r.X >> 16, r.Y >> 16) == c.Cell) covered = true;
+        }
+        if (covered) {
+            c.Return = 1;
+        } else {
+            Place_Crate(c);
+        }
+    }
+    int i = 0;
+    while (i < M.HazardCount) {
+        Hazard& h = M.Hazards[i];
+        bool gone = false;
+        switch (h.Kind) {
+        case RALLY_HAZ_MINE: gone = Update_Mine(h); break;
+        case RALLY_HAZ_ROCKET:
+        case RALLY_HAZ_HOMING: gone = Update_Missile(h); break;
+        case RALLY_HAZ_ION_MARK: gone = Update_Ion(h); break;
+        default: gone = true; break;
+        }
+        if (gone) {
+            for (int j = i; j + 1 < M.HazardCount; ++j) M.Hazards[j] = M.Hazards[j + 1];
+            --M.HazardCount;
+        } else {
+            ++i;
+        }
+    }
+}
+
+} // namespace rally
diff --git a/tiberiandawn/rally_physics.cpp b/tiberiandawn/rally_physics.cpp
new file mode 100644
index 0000000..ea8319e
--- /dev/null
+++ b/tiberiandawn/rally_physics.cpp
@@ -0,0 +1,571 @@
+// OpenCNC3D Tiberian Dawn Rally: vehicle physics.
+//
+// Each racer is a circle that moves in fine units (1/256 lepton) with several
+// substeps per engine tick. Its velocity is split into a forward and a sideways part:
+// throttle and brake work on the forward part, grip removes the sideways part, and a
+// drift removes much less of it. Steering turns the hull at a rate that grows with
+// speed. Blocked cells (by the vehicle's locomotion, walls, buildings, trees, the map
+// edge and ground units that are not racers) are squares the circle is pushed out of
+// with a bounce; racers bounce off each other by mass. A racer can be thrown into the
+// air, spin there, and land on its roof, after which it rights itself.
+//
+// Integers only. Positions in fine units, velocities in fine units per tick with 8
+// fraction bits, angles as 16-bit binary angles with 8 fraction bits.
+//
+// One racer's driving through a tick (Drive_Begin, the substeps, Drive_End) touches
+// nothing but that racer and the counters it is handed, and reads the map without
+// changing it. That is what lets OpenCNC3D_Rally_Predict run the very same code on a
+// copy of the local racer, ahead of the lockstep, without changing the race.
+#include "function.h"
+#include "rally_internal.h"
+
+namespace rally {
+
+namespace {
+
+const int32_t GRAVITY = 3000;     // cells/s^2 x100
+const int DRIFT_CHARGE = 5;       // tenths of a second of drift that charge a mini-turbo
+const int RESTITUTION_WALL = 30;  // percent
+const int RESTITUTION_RACER = 40; // percent
+
+int32_t Radius_Of(const Racer& r)
+{
+    return (int32_t)((int64_t)Kart_Of(r).Radius * FINE / 100);
+}
+
+int Cps100(int64_t v)
+{
+    return (int)(v * 10 * M.TicksPerSecondX10 / 16777216);
+}
+
+SpeedType Locomotion(const Racer& r)
+{
+    return UnitTypeClass::As_Reference((UnitType)Kart_Of(r).Type).Speed;
+}
+
+// Top speed and acceleration scale by the ground under the vehicle, in percent.
+int Ground_Percent(const Racer& r)
+{
+    const CELL cell = XY_Cell(r.X >> 16, r.Y >> 16);
+    if ((unsigned)cell >= MAP_CELL_TOTAL) return 80;
+    switch (Map[cell].Land_Type()) {
+    case LAND_CLEAR:
+    case LAND_ROAD:
+        return 100;
+    case LAND_BEACH:
+        return 85;
+    case LAND_TIBERIUM:
+        return 75;
+    case LAND_WATER:
+        return 90; // only a hovercraft gets here
+    default:
+        return 80;
+    }
+}
+
+int32_t Wrap_Signed(int32_t angle)
+{
+    // Keeps a signed angle with 8 fraction bits inside -180..180 degrees.
+    return (int32_t)((uint32_t)(angle + (1 << 23)) & 0xFFFFFF) - (1 << 23);
+}
+
+void Push_Out(Racer& r, int32_t nx, int32_t ny, int32_t depth, int restitution)
+{
+    r.X += (int32_t)(((int64_t)nx * depth) >> 16) + (nx > 0 ? 1 : nx < 0 ? -1 : 0);
+    r.Y += (int32_t)(((int64_t)ny * depth) >> 16) + (ny > 0 ? 1 : ny < 0 ? -1 : 0);
+    const int64_t vn = ((int64_t)r.VX * nx + (int64_t)r.VY * ny) >> 16;
+    if (vn < 0) {
+        const int64_t j = vn * (100 + restitution) / 100;
+        r.VX -= (int32_t)((j * nx) >> 16);
+        r.VY -= (int32_t)((j * ny) >> 16);
+        if (-vn > r.Impact) r.Impact = (int32_t)-vn;
+    }
+}
+
+// Pushes the racer's circle out of every blocked cell it overlaps.
+void Collide_Static(Racer& r)
+{
+    const int32_t radius = Radius_Of(r);
+    for (int pass = 0; pass < 3; ++pass) {
+        bool moved = false;
+        const int cx0 = (r.X - radius) >> 16, cx1 = (r.X + radius) >> 16;
+        const int cy0 = (r.Y - radius) >> 16, cy1 = (r.Y + radius) >> 16;
+        for (int cy = cy0; cy <= cy1; ++cy) {
+            for (int cx = cx0; cx <= cx1; ++cx) {
+                if (cx < 0 || cy < 0 || cx >= MAP_CELL_W || cy >= MAP_CELL_H) continue;
+                if (!Cell_Blocked(XY_Cell(cx, cy), &r)) continue;
+                const int32_t x0 = cx << 16, x1 = x0 + FINE;
+                const int32_t y0 = cy << 16, y1 = y0 + FINE;
+                const int32_t qx = r.X < x0 ? x0 : r.X > x1 ? x1 : r.X;
+                const int32_t qy = r.Y < y0 ? y0 : r.Y > y1 ? y1 : r.Y;
+                const int64_t dx = (int64_t)r.X - qx, dy = (int64_t)r.Y - qy;
+                const int64_t d2 = dx * dx + dy * dy;
+                if (d2 >= (int64_t)radius * radius) continue;
+                if (d2 == 0) {
+                    // The centre is inside the square: leave by the nearest face.
+                    const int32_t left = r.X - x0, right = x1 - r.X, top = r.Y - y0, bottom = y1 - r.Y;
+                    int32_t best = left, nx = -65536, ny = 0;
+                    if (right < best) best = right, nx = 65536, ny = 0;
+                    if (top < best) best = top, nx = 0, ny = -65536;
+                    if (bottom < best) best = bottom, nx = 0, ny = 65536;
+                    Push_Out(r, nx, ny, best + radius, RESTITUTION_WALL);
+                } else {
+                    const int64_t d = Isqrt((uint64_t)d2);
+                    const int32_t nx = (int32_t)(dx * 65536 / d), ny = (int32_t)(dy * 65536 / d);
+                    Push_Out(r, nx, ny, (int32_t)(radius - d), RESTITUTION_WALL);
+                }
+                moved = true;
+            }
+        }
+        if (!moved) break;
+    }
+}
+
+void Move(Racer& r, int32_t dx, int32_t dy)
+{
+    if (!dx && !dy) return;
+    const int32_t radius = Radius_Of(r);
+    const int32_t adx = dx < 0 ? -dx : dx, ady = dy < 0 ? -dy : dy;
+    const int32_t longest = adx > ady ? adx : ady;
+    const int32_t step = radius / 2 > 256 ? radius / 2 : 256;
+    const int n = 1 + longest / step;
+    int32_t done_x = 0, done_y = 0;
+    for (int i = 1; i <= n; ++i) {
+        const int32_t tx = (int32_t)((int64_t)dx * i / n), ty = (int32_t)((int64_t)dy * i / n);
+        const int32_t sx = r.X, sy = r.Y;
+        r.X += tx - done_x;
+        r.Y += ty - done_y;
+        done_x = tx;
+        done_y = ty;
+        Collide_Static(r);
+        // The safety net: a centre must never come to rest in a blocked cell.
+        if (Point_Blocked(r.X, r.Y, &r)) {
+            r.X = sx;
+            r.Y = sy;
+            r.VX = r.VY = 0;
+            return;
+        }
+    }
+}
+
+void Land(Racer& r, int* stats)
+{
+    const int32_t roll = (int16_t)(r.Roll >> 8), pitch = (int16_t)(r.Pitch >> 8);
+    const int32_t landing = r.VZ;
+    r.Z = 0;
+    r.VZ = 0;
+    r.PitchRate = r.RollRate = 0;
+    if (roll > 16384 || roll < -16384 || pitch > 16384 || pitch < -16384) {
+        // On its roof or side: it lies there until it rights itself. Thrown again while
+        // already flipped, the three seconds keep counting rather than start over.
+        if (!(r.Flags & RALLY_F_FLIPPED)) {
+            r.Flags |= RALLY_F_FLIPPED;
+            r.FlipTicks = 0;
+            ++stats[STAT_FLIPS];
+        }
+        r.Roll = (roll < 0 ? -32767 : 32767) * 256;
+        r.Pitch = 0;
+        return;
+    }
+    // Wheels down, even if it went up flipped.
+    r.Flags &= ~RALLY_F_FLIPPED;
+    r.FlipTicks = 0;
+    r.Roll = r.Pitch = 0;
+    if (-landing > Velocity(400)) {
+        r.VZ = -landing / 4; // a small bounce off a hard landing
+        r.Z = 1;
+    }
+}
+
+void Substep(Racer& r, int* stats)
+{
+    const KartStats& k = Kart_Of(r);
+    const bool righting = (r.Flags & RALLY_F_RIGHTING) != 0;
+    const bool flipped = (r.Flags & RALLY_F_FLIPPED) != 0;
+    const bool finished = (r.Flags & RALLY_F_FINISHED) != 0;
+    const bool air = !righting && (r.Z > 0 || r.VZ > 0);
+    const bool control = M.Phase == RALLY_PHASE_RACE && !air && !flipped && !righting && r.Spin == 0 && !finished;
+    const uint32_t bits = control ? r.Bits : 0;
+
+    const int ground = Ground_Percent(r);
+    int64_t top = (int64_t)Velocity(k.Top) * ground / 100;
+    int64_t accel = (int64_t)Accel(k.Accel) * ground / 100;
+    if (r.Boost > 0) {
+        top = top * r.BoostTop / 100;
+        accel = accel * r.BoostAccel / 100;
+    }
+    if (r.Armour > 0) top = top * 125 / 100;
+    if (!r.Human || r.Autopilot) {
+        static const int skill_speed[4] = {90, 95, 100, 100};
+        top = top * skill_speed[r.Skill & 3] / 100;
+    }
+
+    // Forward and sideways parts of the velocity in the hull's frame.
+    int32_t yaw16 = (r.Yaw >> 8) & 0xFFFF;
+    int64_t fx = Sin16(yaw16), fy = -Cos16(yaw16);
+    int64_t fv = ((int64_t)r.VX * fx + (int64_t)r.VY * fy) >> 16;
+
+    // Steering grows with speed up to a third of the top speed, and reverses in reverse.
+    int steer = ((bits & RALLY_IN_RIGHT) ? 1 : 0) - ((bits & RALLY_IN_LEFT) ? 1 : 0);
+    // A drift starts with the drift key and a steer key at speed. It keeps turning that
+    // way for as long as the drift key is held and the speed holds up, whatever the steer
+    // keys do: steering into it tightens the turn, steering out of it widens it.
+    if (!control || !(bits & RALLY_IN_DRIFT) || fv <= top * 40 / 100) {
+        r.DriftDir = 0;
+    } else if (r.DriftDir == 0 && steer != 0) {
+        r.DriftDir = steer;
+    }
+    const bool drifting = r.DriftDir != 0;
+    if (steer || drifting) {
+        const int64_t afv = fv < 0 ? -fv : fv;
+        const int64_t ramp = top / 3 > 0 ? top / 3 : 1;
+        int64_t factor = afv * 100 / ramp;
+        if (factor > 100) factor = 100;
+        int64_t turn = (int64_t)Turn_Rate(k.Turn) * factor / 100;
+        if (drifting) {
+            turn = turn * (steer == r.DriftDir ? 120 : steer == -r.DriftDir ? 60 : 90) / 100;
+            steer = r.DriftDir;
+        } else if (fv < 0) {
+            steer = -steer;
+        }
+        r.Yaw = (int32_t)((r.Yaw + steer * turn) & 0xFFFFFF);
+    }
+    if (r.Spin > 0) r.Yaw = (r.Yaw + r.SpinRate) & 0xFFFFFF;
+    if (drifting) r.Flags |= RALLY_F_DRIFT;
+
+    yaw16 = (r.Yaw >> 8) & 0xFFFF;
+    fx = Sin16(yaw16);
+    fy = -Cos16(yaw16);
+    const int64_t rx = -fy, ry = fx; // right of the hull
+    fv = ((int64_t)r.VX * fx + (int64_t)r.VY * fy) >> 16;
+    int64_t lv = ((int64_t)r.VX * rx + (int64_t)r.VY * ry) >> 16;
+
+    if (control) {
+        const bool throttle = (bits & RALLY_IN_THROTTLE) != 0;
+        const bool brake = (bits & RALLY_IN_BRAKE) != 0;
+        if (throttle && !brake) {
+            if (fv < 0) fv += accel * 2; // throttle while rolling back brakes first
+            if (fv < top) {
+                fv += accel;
+                if (fv > top) fv = top;
+            } else {
+                fv -= ((fv - top) * Decay(200)) >> 16;
+            }
+        } else if (brake) {
+            if (fv > 0) {
+                int64_t brake_rate = (int64_t)Accel(k.Accel * 5 / 2 > 800 ? k.Accel * 5 / 2 : 800);
+                fv -= brake_rate;
+                if (fv < 0) fv = 0;
+            } else {
+                const int64_t back = -(top * 40 / 100);
+                if (fv > back) {
+                    fv -= accel * 70 / 100;
+                    if (fv < back) fv = back;
+                } else {
+                    fv -= ((fv - back) * Decay(200)) >> 16;
+                }
+            }
+        } else {
+            fv -= (fv * Decay(80)) >> 16;
+            const int64_t roll_drag = Accel(100);
+            if (fv > roll_drag) fv -= roll_drag;
+            else if (fv < -roll_drag) fv += roll_drag;
+            else fv = 0;
+        }
+        if (fv > top && !throttle) fv -= ((fv - top) * Decay(200)) >> 16;
+    } else if (air) {
+        fv -= (fv * Decay(10)) >> 16;
+    } else {
+        fv -= (fv * Decay(flipped ? 500 : finished ? 250 : 150)) >> 16;
+    }
+
+    // Grip removes the sideways slide; a drift and the air keep most of it.
+    int grip_rate;
+    if (air) grip_rate = 10;
+    else if (flipped || righting) grip_rate = 500;
+    else if (drifting) grip_rate = k.Grip * 8;
+    else grip_rate = k.Grip * 18;
+    lv -= (lv * Decay(grip_rate)) >> 16;
+
+    r.VX = (int32_t)((fv * fx + lv * rx) >> 16);
+    r.VY = (int32_t)((fv * fy + lv * ry) >> 16);
+    r.Speed = (int32_t)fv;
+
+    if (air) {
+        r.VZ -= Accel(GRAVITY);
+        r.Z += r.VZ / 1024;
+        r.Pitch = Wrap_Signed(r.Pitch + r.PitchRate);
+        r.Roll = Wrap_Signed(r.Roll + r.RollRate);
+        if (r.Z <= 0) Land(r, stats);
+    }
+
+    Move(r, r.VX / (256 * SUBSTEPS), r.VY / (256 * SUBSTEPS));
+}
+
+struct RamHit
+{
+    int Damage;
+    int Source;
+};
+
+void Collide_Racers(RamHit* hits)
+{
+    for (int i = 0; i < M.RacerCount; ++i) {
+        Racer& a = M.Racers[i];
+        if (!Racer_Alive(a) || (a.Flags & RALLY_F_FINISHED)) continue;
+        for (int j = i + 1; j < M.RacerCount; ++j) {
+            Racer& b = M.Racers[j];
+            if (!Racer_Alive(b) || (b.Flags & RALLY_F_FINISHED)) continue;
+            if (abs(a.Z - b.Z) > FINE / 2) continue;
+            const int64_t dx = (int64_t)b.X - a.X, dy = (int64_t)b.Y - a.Y;
+            const int64_t reach = Radius_Of(a) + Radius_Of(b);
+            const int64_t d2 = dx * dx + dy * dy;
+            if (d2 >= reach * reach) continue;
+            int64_t d = Isqrt((uint64_t)d2);
+            int64_t nx = 65536, ny = 0;
+            if (d > 0) {
+                nx = dx * 65536 / d;
+                ny = dy * 65536 / d;
+            }
+            const int64_t ma = Kart_Of(a).Mass, mb = Kart_Of(b).Mass;
+            const int64_t depth = reach - d + 2;
+            a.X -= (int32_t)((nx * depth * mb / (ma + mb)) >> 16);
+            a.Y -= (int32_t)((ny * depth * mb / (ma + mb)) >> 16);
+            b.X += (int32_t)((nx * depth * ma / (ma + mb)) >> 16);
+            b.Y += (int32_t)((ny * depth * ma / (ma + mb)) >> 16);
+            const int64_t vrel = (((int64_t)b.VX - a.VX) * nx + ((int64_t)b.VY - a.VY) * ny) >> 16;
+            if (vrel < 0) {
+                const int64_t imp = -vrel * (100 + RESTITUTION_RACER) / 100;
+                a.VX -= (int32_t)(((imp * mb / (ma + mb)) * nx) >> 16);
+                a.VY -= (int32_t)(((imp * mb / (ma + mb)) * ny) >> 16);
+                b.VX += (int32_t)(((imp * ma / (ma + mb)) * nx) >> 16);
+                b.VY += (int32_t)(((imp * ma / (ma + mb)) * ny) >> 16);
+                const int impact = Cps100(-vrel);
+                if (impact > 300) {
+                    // A hard ram hurts the lighter vehicle (both when equal).
+                    const int base = (impact - 300) * 6 / 100;
+                    if (ma <= mb) {
+                        const int dmg = (int)(base * mb / ma);
+                        if (dmg > hits[i].Damage) hits[i] = {dmg, j};
+                    }
+                    if (mb <= ma) {
+                        const int dmg = (int)(base * ma / mb);
+                        if (dmg > hits[j].Damage) hits[j] = {dmg, i};
+                    }
+                }
+                // Armour throws whatever it rams.
+                if (a.Armour > 0 && b.Armour == 0 && hits[j].Damage < 60) hits[j] = {60, i};
+                if (b.Armour > 0 && a.Armour == 0 && hits[i].Damage < 60) hits[i] = {60, j};
+            }
+            Collide_Static(a);
+            Collide_Static(b);
+            if (Point_Blocked(a.X, a.Y, &a)) {
+                a.X = a.PrevX;
+                a.Y = a.PrevY;
+            }
+            if (Point_Blocked(b.X, b.Y, &b)) {
+                b.X = b.PrevX;
+                b.Y = b.PrevY;
+            }
+        }
+    }
+}
+
+void Tick_Flip(Racer& r, int* stats)
+{
+    if (r.Flags & RALLY_F_FLIPPED) {
+        ++r.FlipTicks;
+        if (r.FlipTicks >= Ticks(30) && r.Z == 0 && r.VZ <= 0) {
+            r.Flags &= ~RALLY_F_FLIPPED;
+            r.Flags |= RALLY_F_RIGHTING;
+            r.Righting = Ticks(6);
+            r.RightingRoll = r.Roll;
+            r.RightingPitch = r.Pitch;
+        }
+    } else if (r.Flags & RALLY_F_RIGHTING) {
+        // A short hop while it rolls back upright.
+        const int total = Ticks(6);
+        --r.Righting;
+        const int t = total - r.Righting;
+        const int64_t apex = FINE * 2 / 5;
+        r.Z = (int32_t)(4 * apex * t * (total - t) / ((int64_t)total * total));
+        r.VZ = 0;
+        r.Roll = (int32_t)((int64_t)r.RightingRoll * r.Righting / total);
+        r.Pitch = (int32_t)((int64_t)r.RightingPitch * r.Righting / total);
+        if (r.Righting <= 0) {
+            r.Flags &= ~RALLY_F_RIGHTING;
+            r.Z = 0;
+            r.Roll = r.Pitch = 0;
+            r.FlipTicks = 0;
+            ++stats[STAT_RIGHTED];
+        }
+    }
+}
+
+void Tick_Drift(Racer& r, int* stats)
+{
+    const bool on = (r.Flags & RALLY_F_DRIFT) != 0;
+    if (on) {
+        ++r.DriftCharge;
+        if (r.DriftCharge >= Ticks(DRIFT_CHARGE)) r.Flags |= RALLY_F_TURBO_READY;
+    } else if (r.DriftWasOn || r.DriftCharge) {
+        // Letting go of a long drift gives a short mini-turbo.
+        if (r.DriftCharge >= Ticks(DRIFT_CHARGE) && r.Boost == 0) {
+            ++stats[STAT_MINI_TURBOS];
+            r.Boost = Ticks(6);
+            r.BoostTop = 130;
+            r.BoostAccel = 200;
+        }
+        r.DriftCharge = 0;
+        r.Flags &= ~RALLY_F_TURBO_READY;
+    }
+    r.DriftWasOn = on;
+}
+
+} // namespace
+
+bool Cell_Blocked(CELL cell, const Racer* r)
+{
+    if ((unsigned)cell >= MAP_CELL_TOTAL) return true;
+    const int x = Cell_X(cell), y = Cell_Y(cell);
+    if (x < Map.MapCellX || y < Map.MapCellY || x >= Map.MapCellX + Map.MapCellWidth
+        || y >= Map.MapCellY + Map.MapCellHeight) {
+        return true;
+    }
+    const CellClass& c = Map[cell];
+    if (c.Overlay != OVERLAY_NONE && OverlayTypeClass::As_Reference(c.Overlay).IsWall) return true;
+    const SpeedType speed = r && r->Kart >= 0 ? Locomotion(*r) : SPEED_WHEEL;
+    if (!Ground[c.Land_Type()].Cost[speed]) return true;
+    if (c.Cell_Building() || c.Cell_Terrain()) return true;
+    for (ObjectClass* object = c.Cell_Occupier(); object; object = object->Next) {
+        if (object->What_Am_I() == RTTI_UNIT && !Rally_Is_Racer((TechnoClass*)object)) return true;
+    }
+    return false;
+}
+
+bool Point_Blocked(int32_t x, int32_t y, const Racer* r)
+{
+    if (x < 0 || y < 0) return true;
+    return Cell_Blocked(XY_Cell(x >> 16, y >> 16), r);
+}
+
+void Drive_Begin(Racer& r)
+{
+    r.Impact = 0;
+    r.PrevX = r.X;
+    r.PrevY = r.Y;
+    r.Flags &= ~RALLY_F_DRIFT;
+}
+
+void Drive_Substep(Racer& r, int* stats)
+{
+    if (Racer_Alive(r)) Substep(r, stats);
+}
+
+void Drive_End(Racer& r, int* stats)
+{
+    if (!Racer_Alive(r)) return;
+    Tick_Flip(r, stats);
+    Tick_Drift(r, stats);
+}
+
+void Physics_Tick()
+{
+    RamHit hits[RALLY_MAX_RACERS];
+    memset(hits, 0, sizeof hits);
+    for (int i = 0; i < M.RacerCount; ++i) Drive_Begin(M.Racers[i]);
+    for (int step = 0; step < SUBSTEPS; ++step) {
+        for (int i = 0; i < M.RacerCount; ++i) Drive_Substep(M.Racers[i], M.Stats);
+        Collide_Racers(hits);
+    }
+    for (int i = 0; i < M.RacerCount; ++i) {
+        Racer& r = M.Racers[i];
+        if (!Racer_Alive(r)) continue;
+        Drive_End(r, M.Stats);
+        Sync_Engine(r);
+    }
+    // Damage last: it can destroy a unit, which must not happen inside the steps.
+    for (int i = 0; i < M.RacerCount; ++i) {
+        Racer& r = M.Racers[i];
+        if (!Racer_Alive(r)) continue;
+        const int impact = Cps100(r.Impact);
+        if (impact > 300) {
+            ++M.Stats[STAT_WALL_HITS];
+            Damage_Racer(r, (impact - 300) * 6 / 100 + 1, -1);
+        }
+        if (hits[i].Damage > 0 && Racer_Alive(r)) {
+            ++M.Stats[STAT_RAMS];
+            const bool thrown = Racer_Index_Valid(hits[i].Source) && M.Racers[hits[i].Source].Armour > 0;
+            Damage_Racer(r, hits[i].Damage, hits[i].Source);
+            if (thrown) Throw_Racer(r, 60, 100);
+        }
+    }
+}
+
+void Sync_Engine(Racer& r)
+{
+    UnitClass* unit = Racer_Unit(r);
+    if (!unit) return;
+    const COORDINATE coord = XY_Coord(r.X >> 8, r.Y >> 8);
+    if (coord != unit->Coord) {
+        const CELL from = Coord_Cell(unit->Coord);
+        unit->Mark(MARK_UP);
+        unit->Coord = coord;
+        unit->Mark(MARK_DOWN);
+        const CELL to = Coord_Cell(coord);
+        if (to != from) {
+            Map[to].Goodie_Check(unit);
+            if (Racer_Unit(r)) {
+                // The engine gives artillery a setup delay when it comes to a halt in a cell;
+                // a racer passes through cells without halting, so its rearm count is kept.
+                const int arm = unit->Arm;
+                unit->Per_Cell_Process(false);
+                if (Racer_Unit(r)) unit->Arm = arm;
+            }
+        }
+    }
+    if (!Racer_Unit(r)) return;
+    unit->PrimaryFacing.Set((DirType)((r.Yaw >> 16) & 255));
+    if (unit->Class->IsTurretEquipped) {
+        unit->SecondaryFacing.Set((DirType)((r.Turret >> 16) & 255));
+    } else {
+        r.Turret = r.Yaw;
+    }
+}
+
+// Infantry under a racer is run over, the way a tracked vehicle crushes it.
+void Run_Over(Racer& r)
+{
+    UnitClass* unit = Racer_Unit(r);
+    if (!unit || r.Z > FINE / 4 || M.Phase != RALLY_PHASE_RACE) return;
+    const int32_t radius = Radius_Of(r) + FINE / 4;
+    const int cx0 = (r.X - radius) >> 16, cx1 = (r.X + radius) >> 16;
+    const int cy0 = (r.Y - radius) >> 16, cy1 = (r.Y + radius) >> 16;
+    for (int cy = cy0; cy <= cy1; ++cy) {
+        for (int cx = cx0; cx <= cx1; ++cx) {
+            if (cx < 0 || cy < 0 || cx >= MAP_CELL_W || cy >= MAP_CELL_H) continue;
+            const CELL cell = XY_Cell(cx, cy);
+            ObjectClass* object = Map[cell].Cell_Occupier();
+            while (object) {
+                ObjectClass* next = object->Next;
+                if (object->What_Am_I() == RTTI_INFANTRY && !unit->House->Is_Ally(object)
+                    && !object->OpenCNC3D_Is_Invincible()) {
+                    const COORDINATE c = object->Center_Coord();
+                    const int64_t dx = (int64_t)Coord_X(c) * 256 - r.X, dy = (int64_t)Coord_Y(c) * 256 - r.Y;
+                    if (dx * dx + dy * dy < (int64_t)radius * radius) {
+                        Sound_Effect(VOC_SQUISH2, c);
+                        object->Record_The_Kill(unit);
+                        object->Mark(MARK_UP);
+                        object->Limbo();
+                        delete object;
+                        if (Map[cell].Overlay == OVERLAY_NONE) new OverlayClass(OVERLAY_SQUISH, cell);
+                        ++M.Stats[STAT_RUN_OVER];
+                    }
+                }
+                object = next;
+            }
+        }
+    }
+}
+
+} // namespace rally
