+/**************************************************************************************************
+ * OpenCNC3D_Proximity_Ok -- Would this building type pass the proximity check on this cell?
+ *
+ * A PURE QUERY. IT ANSWERS THE CURSOR ROUTINE, NOT THE COMMIT ROUTINE, and that distinction
+ * cost a round on 26 Aug 2026, so read it before trusting an answer from here.
+ *
+ * There are THREE copies of the adjacency rule in this engine and they are not the same rule:
+ *   DisplayClass::Passes_Proximity_Check  -- colours the cursor. Accepts adjacency to any
+ *                                            TECHNO, units included. This is what this query
+ *                                            calls.
+ *   DLLExportClass::Passes_Proximity_Check -- fills PlacementCellInfo, which is the overlay the
+ *                                            sidebar draws and the only thing the player sees.
+ *   BuildingClass::Passes_Proximity_Check  -- HouseClass::Place_Object's gate. Requires a
+ *                                            BUILDING next door, not merely a techno.
+ * And a fourth fact on top: DLLExportClass::Place has its proximity test commented out behind
+ * `#if (0)`, so a placement request from the client is honoured whatever any of them said.
+ *
+ * A green answer from this export therefore does NOT mean a building will go down there, and a
+ * red one does not mean it will not.
+ * Nothing else in the program can ask this question from outside a live placement: the flag the
+ * placement cursor reads is filled in per cell only while a structure is actually being placed,
+ * which needs a completed building and a minute of construction to reach. Gate G107 asks this
+ * instead, on the same cell, with the switch off and then on.
+ *
+ * It answers the same routine the real placement answers -- DisplayClass::Passes_Proximity_Check
+ * with the type's own occupy list -- so a green answer here and a red cursor in the game would
+ * be a genuine contradiction rather than two different questions.
+ *
+ * Returns false for an unknown type name or an unknown player, which are indistinguishable from
+ * "not allowed" on purpose: a caller that cannot spell the type has no business getting a yes.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Proximity_Ok(uint64 player_id,
+                                                                 const char* type_name,
+                                                                 int cell_x,
+                                                                 int cell_y)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE || type_name == NULL) {
+        return false;
+    }
+
+    StructType st = BuildingTypeClass::From_Name(type_name);
+    if (st == STRUCT_NONE) {
+        return false;
+    }
+
+    BuildingTypeClass const& btype = BuildingTypeClass::As_Reference(st);
+    CELL cell = XY_Cell(cell_x, cell_y);
+
+    return Map.Passes_Proximity_Check(&btype, house, btype.Occupy_List(true), cell);
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Force_Verdict -- Ends the mission now, won or lost, for one player (project OpenCNC3D).
+ *
+ * WHY IT IS Flag_To_Win / Flag_To_Lose AND NOT A SHORTCUT. Those two are the engine's own
+ * ending, the same pair every winning trigger and every "you have no buildings left" path
+ * reaches (house.cpp). They do not end the mission on the spot; they raise IsToWin / IsToDie,
+ * and HouseClass::AI acts on the flag a moment later, which is what runs the whole ending in
+ * its proper order -- the score tally, the win or lose movie, the campaign's next step. A
+ * cheat that fabricated a game-over event instead would skip all of that and would be testing
+ * a path the game never takes.
+ *
+ * That also means this is not instant to the frame. The verdict lands within a tick or so of
+ * the button, not inside it, and that delay is the engine working rather than the cheat
+ * failing.
+ *
+ * Returns false when player_id names nobody in this match, or when the house is already
+ * flagged, in which case nothing changed.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Force_Verdict(uint64 player_id, bool win)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+
+    HouseClass* hptr = HouseClass::As_Pointer(house);
+    if (hptr == NULL) {
+        return false;
+    }
+
+    return win ? hptr->Flag_To_Win() : hptr->Flag_To_Lose();
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Grant_Superweapons -- Gives one player every super weapon, ready now (project OpenCNC3D).
+ *
+ * WHY THIS EXPORT EXISTS, when the debug interface already looks like it covers this.
+ * CNC_Handle_Debug_Request has DEBUG_REQUEST_SUPERWEAPON_RECHARGE, and it calls
+ * Forced_Charge(true) on all three of PlayerPtr's supers. That request cannot do what a
+ * cheat menu needs, because SuperClass::Forced_Charge opens with "if (IsPresent)" and does
+ * NOTHING otherwise (super.cpp). IsPresent is set by SuperClass::Enable, which the game only
+ * reaches when the player finishes an Advanced Communications Center or a Temple of Nod. So
+ * the existing request RECHARGES a super weapon the player already owns, and a player who
+ * owns none gets silence. "Unlock Superweapons" has to grant them first.
+ *
+ * WHAT IT DOES. Enable then Forced_Charge on all three -- IonCannon, NukeStrike, AirStrike.
+ * Enable is called quiet and not-one-time: quiet suppresses the EVA line, because the caller
+ * re-arms this every tick to defeat the recharge countdown and an announcement fifteen times
+ * a second is not a feature. Enable's own "if (quiet) Suspend(true)" is then undone by
+ * Forced_Charge, which clears IsSuspended and sets IsReady, so the net state is present,
+ * unsuspended and ready. All three calls are idempotent, which is what makes a per-tick
+ * re-arm safe and is precisely how the countdown is defeated: after a strike is spent the
+ * next tick makes it ready again.
+ *
+ * IsRecalcNeeded is set ONLY when something actually changed, because the sidebar rebuilds
+ * on that flag and setting it every tick would rebuild the strip fifteen times a second.
+ *
+ * SCOPE. Off by default and never called unless the cheat menu asks. Turning it back off
+ * calls Remove(true) on all three, so the switch is symmetric rather than one-way -- a
+ * one-way cheat is a trap in a menu that has a "Reset to Defaults" button.
+ *
+ * Returns false when player_id names nobody in this match, in which case nothing changed.
+ **************************************************************************************************/
+/*
+**	Put one special into the sidebar strip, the way HouseClass::AI does it. The two arms
+**	are the game's own: GLYPHX multiplayer has a per-player sidebar and everything else
+**	has the one local strip.
+*/
+static void OpenCNC3D_Add_Special(HouseClass* hptr, SpecialWeaponType spc)
+{
+    if (GameToPlay == GAME_GLYPHX_MULTIPLAYER) {
+        if (hptr->IsHuman) {
+#ifdef REMASTER_BUILD
+            Sidebar_Glyphx_Add(RTTI_SPECIAL, spc, hptr);
+#endif
+        }
+    } else if (hptr == PlayerPtr) {
+        Map.Add(RTTI_SPECIAL, spc);
+        Map.Column[1].Flag_To_Redraw();
+    }
+}
+
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Grant_Superweapons(uint64 player_id, bool on)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+
+    HouseClass* hptr = HouseClass::As_Pointer(house);
+    if (hptr == NULL) {
+        return false;
+    }
+
+    /* Remember that these came from the cheat rather than from a building. The nuke is
+       the reason: HouseClass::Place_Special_Blast refuses to launch one in single player
+       unless the house owns a Temple of Nod, and a cheat-granted nuke has no Temple to
+       find. The mask lets that one launch off the map edge the way multiplayer does. */
+    HouseClass::OpenCNC3D_Set_Cheat_Supers(house, on);
+
+    bool changed = false;
+    if (on) {
+        /* ENABLE IS NOT ENOUGH ON ITS OWN, and this cost a build to find out. Enable sets
+           the HouseClass's IsPresent, but the exported sidebar is built by walking
+           Map.Column[c].Buildables[b] (this file, the RTTI_SPECIAL arm of
+           CNC_Get_Sidebar_State), and nothing puts a special INTO that strip except an
+           explicit Map.Add. Granting without it produced a house that owned three charged
+           super weapons and a sidebar that listed one entry. The sequence below is
+           HouseClass::AI's own (house.cpp:1286-1302), copied rather than invented.
+           Map.Add is called ONLY when Enable actually granted, so the per-tick re-arm
+           does not push duplicates into the strip. */
+        /* ONE TIME = true, and that flag is doing something specific rather than being a
+           guess. HouseClass::AI revokes a super weapon whose building the player does not
+           own -- "Remove the ion cannon when there is no advanced communication facility"
+           (house.cpp:1244-1252) -- and it calls the UNFORCED Remove. SuperClass::Remove
+           opens with "if (IsPresent && (!IsOneTime || forced))" (super.cpp), so a one-time
+           grant survives that sweep and an ordinary grant does not. MEASURED: with
+           onetime=false the Air Strike appeared in the sidebar and the Ion Cannon and the
+           Nuclear Strike were gone again within a tick, because SCG01EA's player owns
+           neither an Advanced Comm Center nor a Temple.
+           IsOneTime also means SuperClass::Discharged REMOVES the weapon after one use
+           instead of recharging it -- which is fine and in fact wanted here, because the
+           per-tick re-arm above grants it straight back. That is the same mechanism that
+           defeats the countdown, and StripClass::Add scans for duplicates before
+           inserting (sidebar.cpp:1471-1476), so re-adding cannot grow the strip. */
+        if (hptr->IonCannon.Enable(true, false, true)) {
+            changed = true;
+            OpenCNC3D_Add_Special(hptr, SPC_ION_CANNON);
+        }
+        if (hptr->NukeStrike.Enable(true, false, true)) {
+            changed = true;
+            OpenCNC3D_Add_Special(hptr, SPC_NUCLEAR_BOMB);
+        }
+        if (hptr->AirStrike.Enable(true, false, true)) {
+            changed = true;
+            OpenCNC3D_Add_Special(hptr, SPC_AIR_STRIKE);
+        }
+        /* And THIS is the countdown. Unconditional, every call, so a strike that was just
+           spent is ready again on the next tick. */
+        hptr->IonCannon.Forced_Charge(false);
+        hptr->NukeStrike.Forced_Charge(false);
+        hptr->AirStrike.Forced_Charge(false);
+    } else {
+        changed |= hptr->IonCannon.Remove(true);
+        changed |= hptr->NukeStrike.Remove(true);
+        changed |= hptr->AirStrike.Remove(true);
+    }
+
+    if (changed) {
+        /* Both of these are HouseClass::AI's own follow-up on the same transition
+           (house.cpp:1248-1252 for the revoke, :1299-1300 for the grant). */
+        if (hptr == PlayerPtr) {
+            Map.Column[1].Flag_To_Redraw();
+        }
+        hptr->IsRecalcNeeded = true;
+    }
+    return true;
+}
+
+/***********************************************************************************************
+ * OpenCNC3D_Spring_Trigger -- Fires one named trigger's ACTION on demand (project OpenCNC3D).
+ *
+ * WHY THIS EXPORT EXISTS.
+ *
+ * Tiberian Dawn's trigger is one event paired with one action: no AND, no OR, no counters
+ * (trigger.h:41-108). OpenCNC3D's editor offers richer conditions in "Enhanced mode", and the
+ * only sane way to give them the game's real effects -- Create Team with its ScenarioInit
+ * bracket, Reinforce with Do_Reinforcements' edge resolution, Allow Win with its Blockage
+ * accounting -- is to let the engine run its OWN action bodies rather than reimplement
+ * eighteen of them, quirks included, outside the DLL.
+ *
+ * So an Enhanced rule compiles to a CARRIER trigger: an ordinary [Triggers] line whose
+ * event is None, carrying the action, house, team and persistence. Nothing inside the
+ * engine ever springs an EVENT_NONE trigger, so the carrier is inert on its own. The host
+ * evaluates the rich condition and calls this when it is satisfied.
+ *
+ * WHY IT USES THE HOUSE ROUTE. There is no shared action dispatcher: Spring(event, object),
+ * Spring(event, cell) and Spring(event, house, data) each carry their own switch(Action),
+ * and several actions differ between them. The house route is the one that is not tied to
+ * a particular object or cell, which is what a host-evaluated condition has. Two actions
+ * are therefore out of reach here and the editor refuses them on a carrier: ACTION_WINLOSE
+ * is object-route only, and ACTION_ALLOWWIN's house-route arm is empty.
+ *
+ * HOW IT MATCHES. Spring's house-route gate is "event != Event || house != House", so
+ * passing the trigger's own Event and House always matches -- including EVENT_NONE, which
+ * skips every data check below the gate and falls straight into the action switch. That is
+ * deliberate: the carrier's Data field is free for the host to use, and cannot be
+ * misread as a credits or building threshold.
+ *
+ * PERSISTENCE IS THE ENGINE'S. Spring ends with "if (success && IsPersistant == VOLATILE)
+ * Remove()", so a one-shot Enhanced rule gets one-shot semantics from the same code that
+ * gives them to a native one, including the cell and object detachment Remove does.
+ *
+ * INPUT:   name -- the carrier trigger's name, as it appears in [Triggers]. Max 4 chars,
+ *                  matched case-insensitively by TriggerClass::As_Pointer.
+ *
+ * OUTPUT:  true if a trigger of that name existed and sprang; false if it did not exist
+ *          (already removed by a volatile firing, or never in the file).
+ *
+ * WARNINGS: none. A missing name is a false, not a crash -- which is the normal case
+ *           after a volatile carrier has fired once.
+ *=============================================================================================*/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Spring_Trigger(const char* name)
+{
+    if (name == NULL || *name == '\0') {
+        return false;
+    }
+    TriggerClass* trig = TriggerClass::As_Pointer(name);
+    if (trig == NULL) {
+        return false;
+    }
+    return trig->Spring(trig->Event, trig->House);
+}
+
+/***********************************************************************************************
+ * OpenCNC3D_Spawn_Anim -- Starts one engine animation at a point on the map (project OpenCNC3D).
+ *
+ * A test hook. The host's effect recordings need each explosion exactly as the engine
+ * produces it -- its stages, its timing, the anim record the renderer reads -- at a place
+ * and moment chosen by a script rather than by a battle. The anim is the engine's own
+ * AnimClass, so it also does whatever that anim does in a game (an ATOM_BLAST damages what
+ * is under it). Nothing in a normal game calls this.
+ *
+ * INPUT:   type -- an AnimType number.
+ *          x, y -- the point, in leptons (256 to a cell).
+ *
+ * OUTPUT:  true if the anim was created.
+ *=============================================================================================*/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Spawn_Anim(int type, int x, int y)
+{
+    if (type < ANIM_FIRST || type >= ANIM_COUNT || x < 0 || y < 0) {
+        return false;
+    }
+    AnimClass* anim = new AnimClass((AnimType)type, XY_Coord(x, y));
+    return anim != NULL;
+}
+
+/***********************************************************************************************
+ * OpenCNC3D_Force_Fire -- Makes one unit fire one of its weapons now (project OpenCNC3D).
+ *
+ * A test hook, the weapon half of OpenCNC3D_Spawn_Anim. The effect picker films each unit's
+ * muzzle flash and projectile trail, and some weapons are only used in circumstances a
+ * script cannot arrange on cue: the Mammoth fires its tusk missiles only when its cannon
+ * cannot fire (the target is behind the turret, or in the narrow band between the two
+ * ranges). This fires the given weapon through the engine's own Fire_At, at the unit's
+ * target, or at the nearest enemy when it has none, whatever the range or the facing.
+ * It is a real shot with a real projectile. Nothing in a normal game calls this.
+ *
+ * INPUT:   heapid -- the unit's id in the Units heap.
+ *          which  -- 0 primary, 1 secondary.
+ *
+ * OUTPUT:  true if a projectile was launched.
+ *=============================================================================================*/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Force_Fire(int heapid, int which)
+{
+    if (heapid < 0 || heapid >= Units.Count()) {
+        return false;
+    }
+    UnitClass* u = Units.Raw_Ptr(heapid);
+    if (u == NULL || !u->IsActive || u->IsInLimbo) {
+        return false;
+    }
+    TARGET target = u->TarCom;
+    if (!Target_Legal(target)) {
+        TechnoClass* best = NULL;
+        int bestd = 0x7fffffff;
+        for (int i = 0; i < Logic.Count(); i++) {
+            ObjectClass* o = Logic[i];
+            if (o == NULL || !o->Is_Techno() || o->IsInLimbo || o == u) {
+                continue;
+            }
+            TechnoClass* t2 = (TechnoClass*)o;
+            if (u->House->Is_Ally(t2->House)) {
+                continue;
+            }
+            int d = u->Distance(t2);
+            if (d < bestd) {
+                bestd = d;
+                best = t2;
+            }
+        }
+        if (best == NULL) {
+            return false;
+        }
+        target = best->As_Target();
+    }
+    /* TechnoClass's own Fire_At, not the turret's override: the override asks Can_Fire
+       first, which refuses a target out of range or off the turret's facing, and a shot
+       on cue is exactly one the unit would not have taken by itself */
+    return ((TechnoClass*)u)->TechnoClass::Fire_At(target, which) != NULL;
+}
+
+/***********************************************************************************************
+ * OpenCNC3D_Weapon_Range -- How far one object's weapon reaches, by heap slot (project OpenCNC3D).
+ *
+ * The three numbers TechnoClass::In_Range tests a target against, so the renderer's range outline
+ * round the player's selected launchers and defences is the engine's reach and not a copy of the
+ * weapon table:
+ *
+ *   the range   TechnoClass::Weapon_Range, the table's range with the engine's own adjustment
+ *               (WEAPON_NIKE reaches twice as far in a campaign game);
+ *   the centre  Fire_Data().Center, the point the distance is measured from, given as its offset
+ *               from Center_Coord (a guard tower measures from 0x30 leptons north of its middle);
+ *   the muzzle  Fire_Data().Distance, which In_Range takes off the distance before comparing, so
+ *               it adds to the reach.
+ *
+ * A target is in range when ::Distance(centre, target) - muzzle <= range, with ::Distance the
+ * engine's max + min/2 measure. A building target is reached (Width + Height) x 64 leptons
+ * further; the outline is the reach against everything else.
+ *
+ * Read only: nothing in the game changes, so lockstep, saves and replays are untouched.
+ *
+ * INPUT:   rtti   -- RTTI_INFANTRY, RTTI_UNIT, RTTI_AIRCRAFT or RTTI_BUILDING.
+ *          id     -- the object's slot in that heap (the dump's id=).
+ *          which  -- 0 for the primary weapon, 1 for the secondary.
+ *          fire_dx, fire_dy, muzzle -- optional out-parameters, in leptons; any may be NULL.
+ *
+ * OUTPUT:  the range in leptons (256 to a cell), 0 for no weapon in that slot, -1 when there
+ *          is no live object in that slot (the out-parameters are then 0).
+ *=============================================================================================*/
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Weapon_Range(int rtti, int id, int which,
+                                                                int* fire_dx, int* fire_dy, int* muzzle)
+{
+    TechnoClass const* techno = NULL;
+    if (fire_dx) *fire_dx = 0;
+    if (fire_dy) *fire_dy = 0;
+    if (muzzle) *muzzle = 0;
+    if (id < 0 || which < 0 || which > 1) {
+        return -1;
+    }
+    if (rtti == RTTI_INFANTRY && id < Infantry.Length()) {
+        techno = Infantry.Raw_Ptr(id);
+    } else if (rtti == RTTI_UNIT && id < Units.Length()) {
+        techno = Units.Raw_Ptr(id);
+    } else if (rtti == RTTI_AIRCRAFT && id < Aircraft.Length()) {
+        techno = Aircraft.Raw_Ptr(id);
+    } else if (rtti == RTTI_BUILDING && id < Buildings.Length()) {
+        techno = Buildings.Raw_Ptr(id);
+    }
+    if (techno == NULL || !techno->IsActive) {
+        return -1;
+    }
+    FireDataType data = techno->Fire_Data(which);
+    COORDINATE center = techno->Center_Coord();
+    if (fire_dx) *fire_dx = (int)Coord_X(data.Center) - (int)Coord_X(center);
+    if (fire_dy) *fire_dy = (int)Coord_Y(data.Center) - (int)Coord_Y(center);
+    if (muzzle) *muzzle = data.Distance;
+    return techno->Weapon_Range(which);
+}
+
+/***********************************************************************************************
+ * OpenCNC3D_Hurt_Object -- Damages one unit or aircraft by its heap slot (project OpenCNC3D).
+ *
+ * A test hook, beside OpenCNC3D_Spawn_Anim. The debug kill (DEBUG_REQUEST_KILL_OBJECT) hits the
+ * occupier of a map cell, which an aircraft in flight never is, so nothing a script could
+ * do brought one down: a test of an aircraft dying in the air had no way to happen. This
+ * applies the damage to the object itself, through its own Take_Damage, so it dies exactly
+ * as it would to a SAM: its explosion, its falling, its removal. Nothing in a normal game
+ * calls this.
+ *
+ * INPUT:   rtti   -- RTTI_UNIT or RTTI_AIRCRAFT.
+ *          id     -- the object's slot in that heap (the dump's id=).
+ *          damage -- points of damage, high explosive.
+ *
+ * OUTPUT:  true if the object was there and took the damage.
+ *=============================================================================================*/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Hurt_Object(int rtti, int id, int damage)
+{
+    TechnoClass* victim = NULL;
+    if (rtti == RTTI_AIRCRAFT && id >= 0 && id < Aircraft.Length()) {
+        AircraftClass* air = Aircraft.Raw_Ptr(id);
+        if (air != NULL && air->IsActive) {
+            victim = air;
+        }
+    } else if (rtti == RTTI_UNIT && id >= 0 && id < Units.Length()) {
+        UnitClass* unit = Units.Raw_Ptr(id);
+        if (unit != NULL && unit->IsActive) {
+            victim = unit;
+        }
+    }
+    if (victim == NULL || victim->Strength <= 0 || damage <= 0) {
+        return false;
+    }
+    int dmg = damage;
+    victim->Take_Damage(dmg, 0, WARHEAD_HE, 0);
+    return true;
+}
+
+/***********************************************************************************************
+ * OpenCNC3D_Sell_Unit -- Sells back one of the player's units standing on a Repair Bay (project OpenCNC3D).
+ *
+ * The 1995 game sells a vehicle parked on the player's Repair Bay: in sell mode the cursor over
+ * it is the sell-unit cursor (DisplayClass::Mouse_Left_Release's ACTION_SELL_UNIT, display.cpp)
+ * and the click queues EventClass::SELL on the unit, which calls FootClass::Sell_Back. The
+ * stock structure door cannot do it: DLLExportClass::Sell builds a building target and reaches
+ * only BuildingClass::Sell_Back. This is the unit's door, and it takes the same steps the 1995
+ * click takes.
+ *
+ * NOT THROUGH THE BAY. Selling the bay itself while a unit stands on it also sells the unit
+ * (BuildingClass::Mission_Deconstruction), but only if the unit is still there when the
+ * mission runs; if it has driven off, the bay goes instead. A click on the unit must sell the
+ * unit or nothing.
+ *
+ * In a lockstep match the SELL event is queued, as the 1995 click queues it, so every peer
+ * sells on the same frame; its arm (event.cpp) calls Sell_Back(-1), which sells a unit
+ * outright. Otherwise the unit is sold here, Sell_Back(1), as DLLExportClass::Sell sells a
+ * building.
+ *
+ * INPUT:   player_id -- the selling player, resolved as every input export resolves it.
+ *          rtti      -- RTTI_UNIT or RTTI_AIRCRAFT.
+ *          id        -- the object's slot in that heap (the dump's id=).
+ *
+ * OUTPUT:  true if the unit was the player's and Can_Demolish allowed the sale, and the sale
+ *          was made or queued; false and nothing changed otherwise.
+ *=============================================================================================*/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Sell_Unit(uint64 player_id, int rtti, int id)
+{
+    if (!DLLExportClass::Set_Player_Context(player_id) || PlayerPtr == NULL) {
+        return false;
+    }
+    FootClass* unit = NULL;
+    if (rtti == RTTI_UNIT && id >= 0 && id < Units.Length()) {
+        unit = Units.Raw_Ptr(id);
+    } else if (rtti == RTTI_AIRCRAFT && id >= 0 && id < Aircraft.Length()) {
+        unit = Aircraft.Raw_Ptr(id);
+    }
+    if (unit == NULL || !unit->IsActive || unit->IsInLimbo || unit->House != PlayerPtr
+        || !unit->Can_Demolish()) {
+        return false;
+    }
+    if (OpenCNC3D_Lockstep) {
+        OutList.Add(EventClass(EventClass::SELL, unit->As_Target()));
+    } else {
+        unit->Sell_Back(1);
+    }
+    return true;
+}
+
+/***********************************************************************************************
+ * OpenCNC3D_Trigger_Info -- Reads one trigger's live state (project OpenCNC3D).
+ *
+ * The host's Enhanced evaluator has to know whether a carrier is still there before it
+ * fires it, and the editor's trace wants to know whether a native trigger has been
+ * removed yet. Both are one field lookups the host has no other way to reach.
+ *
+ * INPUT:   name  -- trigger name.
+ *          event, action, data, persist -- optional out-parameters; any may be NULL.
+ *
+ * OUTPUT:  true if the trigger exists.
+ *=============================================================================================*/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Trigger_Info(const char* name,
+                                                                 int* event,
+                                                                 int* action,
+                                                                 int* data,
+                                                                 int* persist)
+{
+    if (name == NULL || *name == '\0') {
+        return false;
+    }
+    TriggerClass* trig = TriggerClass::As_Pointer(name);
+    if (trig == NULL) {
+        return false;
+    }
+    if (event != NULL) {
+        *event = (int)trig->Event;
+    }
+    if (action != NULL) {
+        *action = (int)trig->Action;
+    }
+    if (data != NULL) {
+        *data = trig->Data;
+    }
+    if (persist != NULL) {
+        *persist = (int)trig->IsPersistant;
+    }
+    return true;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Building_By_Heapid -- resolves the id the object dump hands out (project OpenCNC3D).
+ *
+ * TWO DIFFERENT NUMBERS ANSWER TO "id" IN THIS HEAP, and the rally exports had taken the wrong
+ * one. OpenCNC3D_Dump_Objects prints Buildings.ID(p), and FixedHeapClass::ID (heap.cpp:248) is
+ * (pointer - Buffer) / Size: the object's RAW slot in the pool. Buildings.Ptr(index) does not
+ * index the pool at all, it indexes ActivePointers, the compacted list of LIVE objects.
+ *
+ * The two agree only until the first building leaves the game. FixedIHeapClass::Free deletes the
+ * pointer out of ActivePointers and closes the gap, and FixedHeapClass::Allocate then hands that
+ * freed RAW slot to the next building while appending it to the END of ActivePointers. One sold
+ * power plant is enough to put every later building's raw id one ahead of its active index, and
+ * the `building_id >= Buildings.Count()` guard these two used to carry compared a raw id against
+ * ActiveCount, so it rejected the highest ones outright.
+ *
+ * That is why a rally point set by a human click stopped flying its flag. The click path posts
+ * EventClass::ARCHIVE against the building itself and never touches an id, so the point landed on
+ * the right building; the renderer then asked OpenCNC3D_Get_Rally about a DIFFERENT one, which had no
+ * archive target and answered "no rally point". A scripted run allocates its buildings in order
+ * and frees none, which is exactly why the gates only ever saw the working case.
+ *
+ * Walks the ACTIVE list and compares Buildings.ID, so only live objects are ever dereferenced.
+ * Raw_Ptr would be shorter and would hand back a freed slot for an id whose building has died.
+ **************************************************************************************************/
+static BuildingClass* OpenCNC3D_Building_By_Heapid(int heapid)
+{
+    if (heapid < 0) {
+        return NULL;
+    }
+    for (int index = 0; index < Buildings.Count(); index++) {
+        BuildingClass* p = Buildings.Ptr(index);
+        if (p != NULL && Buildings.ID(p) == heapid) {
+            return p;
+        }
+    }
+    return NULL;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Set_Rally -- Sets or clears a factory's rally point (project OpenCNC3D).
+ *
+ * WHY THIS EXPORT EXISTS. The click path in BuildingClass::Active_Click_With already posts the
+ * EventClass::ARCHIVE that sets a rally point, and that is the path a human uses. This export is
+ * for the renderer's own gesture and for scripts: it posts the SAME event, so there is exactly one
+ * way a rally point is ever set and a gate exercises the real one.
+ *
+ * A CELL, NEVER AN OBJECT TARGET, and that is not a preference. Nothing clears a BUILDING's
+ * ArchiveTarget when its target dies: the only clearing site in the tree is FootClass::Detach
+ * (foot.cpp:1909-1911) and BuildingClass does not inherit it. A rally point aimed at a unit would
+ * become a dangling target the moment that unit died.
+ *
+ * cell_x < 0 CLEARS the rally point.
+ *
+ * Resolves the house through OpenCNC3D_House_Of_Player and deliberately NOT through
+ * Set_Player_Context, for the reason spelled out above OpenCNC3D_Set_Invincible: Set_Player_Context
+ * does not merely resolve an id, it MOVES the engine's local player and leaves it moved.
+ *
+ * Returns false when the player, the building or the cell does not resolve, in which case nothing
+ * was posted.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Set_Rally(uint64 player_id, int building_id,
+                                                              int cell_x, int cell_y)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+    BuildingClass* b = OpenCNC3D_Building_By_Heapid(building_id);
+    if (b == NULL || b->House == NULL || b->House->Class->House != house) {
+        return false;
+    }
+    if (!b->OpenCNC3D_Can_Rally()) {
+        return false;
+    }
+
+    if (cell_x < 0) {
+        OutList.Add(EventClass(EventClass::ARCHIVE, b->As_Target(), TARGET_NONE));
+        return true;
+    }
+    if (cell_x >= MAP_CELL_W || cell_y < 0 || cell_y >= MAP_CELL_H) {
+        return false;
+    }
+    CELL cell = XY_Cell(cell_x, cell_y);
+    OutList.Add(EventClass(EventClass::ARCHIVE, b->As_Target(), ::As_Target(cell)));
+    return true;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Get_Rally -- Reads a factory's rally cell back, or -1,-1 (project OpenCNC3D).
+ *
+ * Pure query: it changes nothing, not even the engine's idea of who the local player is. The
+ * renderer needs it to draw the marker, and a gate needs it to assert the point actually landed
+ * rather than that a click was accepted.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Get_Rally(int building_id, int* cell_x, int* cell_y)
+{
+    if (cell_x) *cell_x = -1;
+    if (cell_y) *cell_y = -1;
+    BuildingClass* b = OpenCNC3D_Building_By_Heapid(building_id);
+    if (b == NULL || !Target_Legal(b->ArchiveTarget)) {
+        return false;
+    }
+    CELL cell = ::As_Cell(b->ArchiveTarget);
+    if (cell_x) *cell_x = Cell_X(cell);
+    if (cell_y) *cell_y = Cell_Y(cell);
+    return true;
+}
+
+/* Per-roster skill levels are separate from legacy handicap difficulty. */
+extern "C" __declspec(dllexport) void __cdecl OpenCNC3D_Set_AI_Difficulties(const unsigned char* levels, int count) { TD_Fair_AI_Set_Levels(levels,count); }
+extern "C" __declspec(dllexport) unsigned int __cdecl OpenCNC3D_AI_Policy() { return fair_ai::PolicyHash(); }
+extern "C" __declspec(dllexport) unsigned int __cdecl OpenCNC3D_AI_State_Hash() { return TD_Fair_AI_Hash(); }
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_AI_Diagnostics(char* out,int size) { return TD_Fair_AI_Diagnostics(out,size); }
+
+/**************************************************************************************************
+ * OpenCNC3D Rally exports. game/rally_abi.h is the contract with the renderer.
+ *
+ * The three orders (pick, input, autopilot) are queued as events exactly like any other player
+ * order: in a lockstep match the host drains and stamps them for every peer, in a skirmish they
+ * go straight to the local DoList and run before the race's tick. Set_Player_Context makes the
+ * named player the event's originator; OpenCNC3D_House_Of_Player only reads the mapping.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Configure(int laps)
+{
+    return Rally_Configure(laps);
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Enable(int enabled, int ticks_per_second_x10)
+{
+    Rally_Enable(enabled != 0, ticks_per_second_x10);
+    return 1;
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Get_State(uint64 player_id, RallyState* out)
+{
+    const HousesType local = Rally_Active() ? OpenCNC3D_House_Of_Player(player_id) : HOUSE_NONE;
+    return Rally_Get_State(local, out);
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Get_Course(RallyCoursePoint* out, int max)
+{
+    return Rally_Get_Course(out, max);
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Get_Roster(int32_t* unit_types, int max)
+{
+    return Rally_Get_Roster(unit_types, max);
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Pick(uint64 player_id, int roster_index)
+{
+    if (!Rally_Active() || !Rally_Roster_Valid(roster_index)) return 0;
+    if (OpenCNC3D_House_Of_Player(player_id) == HOUSE_NONE) return 0;
+    if (!DLLExportClass::Set_Player_Context(player_id)) return 0;
+    return OutList.Add(EventClass(EventClass::RALLY_PICK, roster_index)) ? 1 : 0;
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Input(uint64 player_id,
+                                                                  uint32_t bits,
+                                                                  int32_t aim_x,
+                                                                  int32_t aim_y)
+{
+    if (!Rally_Active() || OpenCNC3D_House_Of_Player(player_id) == HOUSE_NONE) return 0;
+    if (!DLLExportClass::Set_Player_Context(player_id)) return 0;
+    EventClass event(EventClass::RALLY_INPUT, 0);
+    memset(&event.Data, 0, sizeof event.Data);
+    event.Data.Rally.Bits = bits;
+    event.Data.Rally.AimX = aim_x;
+    event.Data.Rally.AimY = aim_y;
+    return OutList.Add(event) ? 1 : 0;
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Autopilot(uint64 player_id, int on)
+{
+    if (!Rally_Active() || OpenCNC3D_House_Of_Player(player_id) == HOUSE_NONE) return 0;
+    if (!DLLExportClass::Set_Player_Context(player_id)) return 0;
+    return OutList.Add(EventClass(EventClass::RALLY_AUTOPILOT, on ? 1 : 0)) ? 1 : 0;
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Choose(uint64 player_id, int choice)
+{
+    if (!Rally_Active() || (choice != RALLY_CHOICE_RETRY && choice != RALLY_CHOICE_END)) return 0;
+    if (OpenCNC3D_House_Of_Player(player_id) == HOUSE_NONE) return 0;
+    if (!DLLExportClass::Set_Player_Context(player_id)) return 0;
+    return OutList.Add(EventClass(EventClass::RALLY_CHOICE, choice)) ? 1 : 0;
+}
+
+/*
+** Where the player's racer will be once the controls it has sent have executed: the race's own
+** driving physics run on a copy, ahead of the lockstep. It changes nothing in the simulation.
+*/
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Predict(uint64 player_id,
+                                                                    const RallyPredictStep* steps,
+                                                                    int n,
+                                                                    RallyRacer* out)
+{
+    const HousesType house = Rally_Active() ? OpenCNC3D_House_Of_Player(player_id) : HOUSE_NONE;
+    if (house == HOUSE_NONE) {
+        if (out) memset(out, 0, sizeof *out);
+        return 0;
+    }
+    return Rally_Predict(house, steps, n, out);
+}
+
+extern "C" __declspec(dllexport) uint32_t __cdecl OpenCNC3D_Rally_Hash(void)
+{
+    return Rally_Hash();
+}
+
+/*
+** Test hooks for headless runs (op codes in game/rally_abi.h). They act on the simulation
+** directly rather than through the order queue, so they belong to single machine tests only.
+*/
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Rally_Debug(int op, int a, int b, int c)
+{
+    return Rally_Debug(op, a, b, c);
+}
