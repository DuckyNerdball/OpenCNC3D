+    case AIRCRAFT:
+        for (int i = 0; i < Aircraft.Count(); i++)
+            if (Aircraft.Ptr(i) && Aircraft.ID(Aircraft.Ptr(i)) == object_to_select_id) { obj = Aircraft.Ptr(i); break; }
