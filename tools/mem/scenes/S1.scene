# S1 Red Alert, first Allied mission (SCG01EA, snow), Enhanced.
# Frames the Soviet base (west half with the lake, east half), the lake and its coast at
# tick 1 and tick 300; then hits one building of each kind until most are past half
# strength (damage pictures, fire, smoke), destroys one power plant and the village
# house (wrecks), and frames the base again 20 and 120 ticks later.
# S5 and S6 run this script in Classic and N64; S15 runs it with --noeinf.
game: ra
scen: SCG01EA
modes: enh
---
gfxload {CFG}
gfx show_stats 0
reveal 1
tick 1
frames 2
memledger t1
cam 62.5 61.5
frames 2
shot {OUT}/t0001_west.png
cam 70.5 63.5
frames 2
shot {OUT}/t0001_east.png
cam 57 56
frames 2
shot {OUT}/t0001_water.png
