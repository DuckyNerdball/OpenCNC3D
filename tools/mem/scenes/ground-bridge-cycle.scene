# Red Alert, Soviet mission 2 (SCU02EA, temperate): the ground rebuilt mid-mission (a
# bridge blown, a save loaded), then the graphics mode switched to N64 and back after
# each rebuild, so the sheets refilled in place and the ones made for the other set are
# re-filtered by the bilinear toggle (ra3d_terrain.h, fx_filter.h). As ground-bridge,
# with the switches.
game: ra
scen: SCU02EA
modes: enh,n64
---
gfxload {CFG}
gfx show_stats 0
reveal 1
tick 30
frames 2
memledger t30
cam 60 56
frames 2
shot {OUT}/t0030_bridge.png
save 1 bridge standing
hurtcell 60 55
tick 3
hurtcell 60 55
tick 3
hurtcell 58 57
tick 3
hurtcell 58 57
tick 40
frames 2
memledger blown
cam 60 56
frames 2
shot {OUT}/t0079_blown.png
gfxmode 1
frames 2
shot {OUT}/t0079_n64.png
gfxmode 2
frames 2
shot {OUT}/t0079_enhanced.png
load 1
tick 1
frames 2
memledger loaded
cam 60 56
frames 2
shot {OUT}/loaded_bridge.png
gfxmode 1
frames 2
shot {OUT}/loaded_n64.png
gfxmode 2
frames 2
shot {OUT}/loaded_enhanced.png
quit
